# 小小镇后端配置
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ---------- 服务器 ----------
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
ENV=development

# ---------- 数据库 ----------
# 用 scripts/db-start 启动的 Docker 数据库，密码固定为 littletown_dev_pw
# （与 backend/docker-compose.yml 的 POSTGRES_PASSWORD 一致，开箱即用）
# 若改用本机原生 PostgreSQL，改成你自己的密码即可
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=littletown_dev_pw
DB_NAME=littletown_db
DB_SSLMODE=disable

# ---------- JWT ----------
# 用于签发登录凭证。上线前务必换成足够长的随机字符串，
# 例如：openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_HOURS=720

# ---------- 微信小程序 ----------
# AppID 是公开信息（小程序前端本身也会用到）
WECHAT_APPID=wxbd8f4a305320e623
# AppSecret 是敏感凭证，切勿提交到版本库或贴到聊天里。
# 获取/重置位置：微信公众平台 → 开发 → 开发管理 → 开发设置 → 小程序密钥
WECHAT_SECRET=your_wechat_secret_here

# ---------- 订阅消息推送 ----------
# 在公众平台「订阅消息」里申请模板，通过审核后把模板 ID 填到这里。
# 留空则会自动跳过推送（本地开发无需配置）。
SUBSCRIBE_TEMPLATE_ID=your_template_id_here
# 用户点击推送消息后跳转的页面
SUBSCRIBE_PAGE=pages/learn/learn
# 每天几点发送复习提醒（0-23，本地时区）。19 点是放学后的家长可提醒时段
PUSH_HOUR=19
# 是否启用定时推送
PUSH_ENABLED=true
# 单次调度最多推送人数
PUSH_BATCH_SIZE=200

# ---------- 学习算法 ----------
# 艾宾浩斯复习间隔（分钟）：5分钟 / 30分钟 / 12小时 / 1天 / 2天 / 4天 / 7天 / 15天 / 30天
REVIEW_INTERVALS=5,30,720,1440,2880,5760,10080,21600,43200
# 每日学习单词数（含复习词与新词）
DAILY_WORD_COUNT=5

# ---------- 日志 ----------
# 日志文件按天切分：logs/app-2026-10-15.log
LOG_DIR=./logs
# 保留天数，启动时清理过期文件；设为 0 表示不清理
LOG_KEEP_DAYS=7

# ---------- 文件上传 ----------
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=5242880
