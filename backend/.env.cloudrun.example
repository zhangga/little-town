# 在现有环境 prod-d4g0vweip50ea1139 / 服务 golang-y91h 的控制台设置环境变量。
# 此文件是参考，不要上传真实 .env；现有 MYSQL_* 变量保留即可。
ENV=production
DEPLOY_TARGET=cloudrun
PORT=80
SERVER_PORT=80
APP_TIMEZONE=Asia/Shanghai
LOG_TO_FILE=false

# 支持已有 MYSQL_ADDRESS、MYSQL_USERNAME、MYSQL_PASSWORD、MYSQL_DATABASE。
# 当前官方 Go 模板默认数据库为 golang_demo。若控制台库名不同，以实际为准。
DB_NAME=golang_demo
DB_TLS=false
DB_TIMEZONE=Asia/Shanghai
DB_MAX_OPEN=10
DB_MAX_IDLE=5

WECHAT_APPID=wxbd8f4a305320e623
WECHAT_SECRET=replace_with_actual_app_secret
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# 首次发布设 true 自动建表、导入词库与建筑。完成后改为 false，减少冷启动工作。
INIT_DATA=true
AUTO_MIGRATE=true

# 云托管缩容到零时，进程内定时器不运行，使用外部任务入口。
PUSH_ENABLED=false
PUSH_HOUR=19
SUBSCRIBE_TEMPLATE_ID=
JOB_TOKEN=
