/* A little wooden lunch counter: cream paper, terracotta boxes and moss ink. */
page { background: #f8eed8; color: #463728; }
.restaurant-page { min-height: 100vh; padding: 26rpx 28rpx 0; box-sizing: border-box; background: radial-gradient(circle at 90% 0, #f4dfb8 0, transparent 34%), #f8eed8; font-family: "PingFang SC", "Hiragino Sans GB", sans-serif; }
.restaurant-page button { margin: 0; padding: 0; font-family: inherit; line-height: 1.4; border-radius: 0; background: transparent; color: inherit; box-sizing: border-box; }
.restaurant-page button::after { border: 0; }
.restaurant-page button[disabled] { opacity: .46; }
.restaurant-page button:active { transform: translateY(2rpx); }
.restaurant-heading { display: flex; justify-content: space-between; align-items: center; padding: 4rpx 2rpx 24rpx; }
.restaurant-eyebrow { display: block; color: #826648; font-size: 21rpx; font-weight: 700; letter-spacing: 3rpx; }
.restaurant-title { display: block; font-family: "STKaiti", "KaiTi", "Kaiti SC", serif; font-size: 49rpx; font-weight: 900; letter-spacing: 1rpx; line-height: 1.45; }
.heading-flower { margin-left: 13rpx; color: #ba5d45; font-family: serif; font-size: 34rpx; }
.restaurant-subtitle { display: block; font-size: 24rpx; color: #806c51; }
.shop-sign { flex-shrink: 0; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 126rpx; height: 124rpx; border: 3rpx solid #9a7851; border-radius: 18rpx; background: #fff8e9; box-shadow: 4rpx 5rpx 0 #d2b88e; transform: rotate(6deg); color: #6b7950; font-size: 20rpx; font-weight: 800; }
.shop-sign-icon { display: block; font-size: 49rpx; line-height: 1.25; }
.restaurant-tabs { display: flex; gap: 8rpx; padding: 7rpx; border: 2rpx solid #d8c9a9; border-radius: 22rpx; background: #e9ddc4; margin-bottom: 26rpx; }
.restaurant-page .restaurant-tab { display: flex; flex: 1; align-items: center; justify-content: center; gap: 12rpx; min-height: 75rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 800; color: #857357; }
.restaurant-page .restaurant-tab-active { color: #fff9e8; background: #596d45; box-shadow: 0 4rpx 0 #3e5030; }
.tab-count { min-width: 30rpx; height: 30rpx; line-height: 30rpx; border-radius: 10rpx; background: #ffffff25; font-size: 19rpx; text-align: center; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 16rpx; }
.section-label { color: #493d2c; font-size: 29rpx; font-weight: 800; }
.section-aside { color: #8a785d; font-size: 21rpx; text-align: right; }
.resident-tables { display: flex; gap: 14rpx; }
.restaurant-page .resident-table { display: flex; flex: 1; min-width: 0; align-items: center; flex-direction: column; padding: 18rpx 8rpx 16rpx; background: #fff9ed; border: 2rpx solid #dfceb0; border-bottom-width: 6rpx; border-radius: 22rpx; }
.restaurant-page .resident-table-selected { border-color: #63794c; background: #edf1dc; }
.resident-portrait { position: relative; display: flex; justify-content: center; align-items: center; width: 80rpx; height: 75rpx; border-radius: 50% 50% 42% 42%; background: #f3d8b9; font-size: 53rpx; }
.resident-taotao { background: #f4d5d0; }
.resident-lin { background: #dee6c3; }
.resident-check { position: absolute; bottom: -1rpx; right: -10rpx; display: flex; justify-content: center; align-items: center; width: 29rpx; height: 29rpx; font-size: 20rpx; border-radius: 50%; background: #627847; color: #fff9e9; border: 3rpx solid #edf1dc; }
.resident-name { font-size: 27rpx; font-weight: 800; margin-top: 9rpx; }
.resident-relation { font-size: 19rpx; color: #8b795f; margin-top: 4rpx; }
.resident-wish { position: relative; margin: 18rpx 0 26rpx; padding: 20rpx 24rpx; border: 2rpx solid #dfceb0; border-radius: 6rpx 22rpx 22rpx; background: #fffbef; }
.wish-heading { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.wish-badge { padding: 3rpx 11rpx; border-radius: 7rpx; background: #f4e0c7; color: #9a5b3e; font-size: 19rpx; font-weight: 800; }
.wish-guest { color: #97846b; font-size: 20rpx; }
.wish-text { display: block; font-size: 27rpx; font-weight: 600; line-height: 1.65; }
.restaurant-page .load-order-button { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 17rpx; padding: 16rpx 18rpx; background: #e8edda; border: 2rpx solid #bac7a3; border-radius: 12rpx; color: #51673b; font-size: 24rpx; font-weight: 700; text-align: left; }
.resident-memory { display: flex; align-items: flex-start; gap: 11rpx; margin-top: 18rpx; border-top: 2rpx dashed #e0d6be; padding-top: 14rpx; color: #8b775d; font-size: 21rpx; line-height: 1.6; }
.memory-flower { color: #c0785c; font-size: 26rpx; }
.memory-quote { display: block; color: #73815a; }
.kitchen-counter { overflow: hidden; background: #edc994; border: 3rpx solid #97734e; border-radius: 27rpx; box-shadow: 0 8rpx 0 #c29a67; }
.counter-heading { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 24rpx 23rpx 18rpx; background: #f6dfb8; border-bottom: 2rpx solid #c5a172; }
.counter-title { display: block; font-family: "STKaiti", "KaiTi", "Kaiti SC", serif; font-size: 31rpx; font-weight: 800; }
.counter-subtitle { display: block; font-size: 19rpx; color: #8b6c48; margin-top: 4rpx; }
.portion-count { flex-shrink: 0; background: #fff5de; border: 2rpx solid #d4b384; padding: 5rpx 12rpx; border-radius: 12rpx; font-size: 20rpx; font-weight: 700; color: #8b6c48; }
.worktop { position: relative; overflow: hidden; padding: 42rpx 38rpx 24rpx; background: repeating-linear-gradient(0deg, transparent, transparent 88rpx, #9a734719 89rpx, transparent 92rpx), linear-gradient(95deg, #edca94, #f4d7a8 40%, #e8bf87); }
.counter-napkin { position: absolute; width: 65%; height: 60%; top: 45rpx; left: 65rpx; background: repeating-linear-gradient(0deg, #ffffff30 0, #ffffff30 22rpx, transparent 22rpx, transparent 44rpx), repeating-linear-gradient(90deg, #d4795b30 0, #d4795b30 22rpx, #fff8e47a 22rpx, #fff8e47a 44rpx); border: 2rpx solid #fff3da; border-radius: 8rpx; transform: rotate(-8deg); }
.counter-chopstick { position: absolute; right: 22rpx; width: 8rpx; height: 56%; top: 14%; background: #98774c; border: 2rpx solid #745a37; border-radius: 5rpx; transform: rotate(-7deg); }
.chopstick-two { right: 39rpx; }
.bento-stage { position: relative; width: 91%; margin: 0 auto; }
.counter-caption { position: relative; display: flex; align-items: center; flex-direction: column; gap: 1rpx; margin-top: 26rpx; color: #7a5938; font-size: 25rpx; font-weight: 800; }
.counter-caption text + text { font-size: 17rpx; font-weight: 500; color: #9c7851; letter-spacing: 2rpx; }
.ingredient-shelf { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 18rpx 20rpx 8rpx; border-top: 2rpx solid #c59f6d; background: #f7e5c8; }
.restaurant-page .ingredient-basket { position: relative; display: flex; align-items: center; justify-content: center; gap: 9rpx; width: calc((100% - 24rpx) / 3); min-height: 81rpx; border: 2rpx solid #d4b895; border-bottom-width: 5rpx; border-radius: 13rpx 13rpx 17rpx 17rpx; background: #fffbef; }
.restaurant-page .ingredient-basket-selected { border-color: #aa6248; background: #f8dfce; }
.ingredient-icon { font-size: 36rpx; line-height: 1; }
.ingredient-name { font-size: 22rpx; font-weight: 700; }
.ingredient-check { position: absolute; top: 1rpx; right: 6rpx; color: #ad634b; font-size: 18rpx; font-weight: 800; }
.kitchen-hint { display: flex; justify-content: center; align-items: center; gap: 9rpx; padding: 14rpx 12rpx 18rpx; background: #f7e5c8; color: #967249; font-size: 20rpx; text-align: center; }
.kitchen-hint text:first-child { color: #ba7653; }
.portion-tools { display: flex; align-items: center; gap: 13rpx; padding: 18rpx 17rpx; margin-top: 19rpx; border: 2rpx dashed #bdc29c; border-radius: 16rpx; background: #f0f1df; }
.tools-label { flex-shrink: 0; font-size: 21rpx; color: #70804e; font-weight: 700; }
.portion-style-buttons { display: flex; flex: 1; flex-wrap: wrap; gap: 8rpx; }
.restaurant-page .tiny-button { padding: 10rpx 12rpx; border: 2rpx solid #d1d4b6; border-radius: 10rpx; background: #fffbed; font-size: 20rpx; }
.restaurant-page .tiny-button-selected { border-color: #75875a; color: #4f6639; background: #e4ebce; }
.restaurant-page .remove-portion { flex-shrink: 0; min-height: 60rpx; padding: 14rpx 4rpx; font-size: 22rpx; color: #a06249; text-decoration: underline; }
.finishing-card { margin-top: 30rpx; padding: 25rpx 22rpx 23rpx; border: 2rpx solid #e2cfb0; border-radius: 22rpx; background: #fffaee; }
.finishing-card .section-heading { margin-bottom: 20rpx; }
.finishing-card .section-label { font-size: 26rpx; }
.finishing-card .section-aside { font-size: 19rpx; }
.option-row { display: flex; gap: 16rpx; align-items: center; margin-top: 17rpx; }
.option-label { flex-shrink: 0; color: #8a7559; font-size: 22rpx; font-weight: 700; }
.option-values { display: flex; align-items: center; gap: 10rpx; flex: 1; flex-wrap: wrap; }
.restaurant-page .option-chip { display: flex; align-items: center; justify-content: center; min-height: 60rpx; gap: 7rpx; padding: 10rpx 16rpx; border: 2rpx solid #dfd1b8; border-radius: 11rpx; background: #fffdf5; color: #897354; font-size: 22rpx; }
.restaurant-page .option-chip-active { border-color: #ad6a50; color: #955039; background: #f5e0cd; }
.box-shape-icon { display: inline-block; width: 19rpx; height: 17rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }
.shape-round { height: 19rpx; border-radius: 50%; }
.color-options { display: flex; gap: 12rpx; margin-left: auto; }
.restaurant-page .color-swatch { display: flex; align-items: center; justify-content: center; width: 45rpx; height: 45rpx; border: 3rpx solid transparent; border-radius: 50%; box-shadow: inset 0 0 0 4rpx #fff9ec; color: #644c36; font-size: 23rpx; font-weight: 800; }
.restaurant-page .color-swatch-selected { border-color: #634c37; }
.restaurant-page .swatch-peach { background: #d99276; }
.restaurant-page .swatch-mint { background: #91ad83; }
.restaurant-page .swatch-sunshine { background: #e2ba59; }
.decoration-row { align-items: flex-start; }
.decoration-row > .option-label { padding-top: 17rpx; }
.decoration-row .option-values { gap: 8rpx; }
.decoration-row .option-chip { padding: 10rpx 13rpx; font-size: 20rpx; }
.dish-name-section { margin-top: 25rpx; padding-top: 20rpx; border-top: 2rpx dashed #e4d6bd; }
.dish-name-field { display: flex; align-items: center; gap: 12rpx; margin-top: 13rpx; padding: 17rpx 15rpx; border: 2rpx solid #d7c3a2; border-radius: 12rpx; background: #fffdf5; }
.dish-name-field > text:first-child { color: #bd7955; font-size: 30rpx; line-height: 1; }
.dish-name-input { flex: 1; min-width: 0; height: 44rpx; font-size: 26rpx; font-weight: 700; color: #4b3d2b; }
.dish-name-placeholder { font-size: 24rpx; font-weight: 400; color: #b8a68b; }
.name-length { flex-shrink: 0; font-size: 18rpx; color: #ae9c82; }
.name-suggestions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.restaurant-page .name-suggestion { min-height: 54rpx; padding: 9rpx 12rpx; border-radius: 9rpx; background: #f2ecd9; color: #7f8057; font-size: 20rpx; }
.save-row { display: flex; align-items: center; gap: 12rpx; margin: 23rpx 0 28rpx; flex-wrap: wrap; }
.restaurant-page .secondary-button { min-height: 74rpx; padding: 16rpx 24rpx; border: 2rpx solid #bdab86; border-bottom-width: 5rpx; border-radius: 15rpx; color: #766044; background: #fff9e9; font-size: 25rpx; font-weight: 800; }
.restaurant-page .text-button { min-height: 65rpx; padding: 15rpx 8rpx; color: #8c7659; font-size: 23rpx; }
.restaurant-page .new-dish-button { margin-left: auto; }
.serve-dock { position: sticky; bottom: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx 0 calc(22rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #d9c9ac; background: #f8eed8f5; }
.serve-dock-copy { min-width: 0; }
.serve-dock-copy > text { display: block; font-size: 23rpx; font-weight: 800; }
.serve-dock-copy > text + text { margin-top: 3rpx; color: #9b876a; font-size: 18rpx; font-weight: 400; }
.restaurant-page .primary-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 19rpx 28rpx; border: 2rpx solid #974a35; border-bottom-width: 7rpx; border-radius: 17rpx; background: #c57254; color: #fff8e5; font-size: 28rpx; font-weight: 800; }
.restaurant-page .serve-button { flex-shrink: 0; min-width: 255rpx; padding-left: 20rpx; padding-right: 20rpx; }

/* Each food is drawn in box-relative dimensions, so saved dishes scale faithfully. */
.bento-shell { position: relative; width: 100%; height: 0; padding-bottom: 78%; border: 3rpx solid #92573f; border-radius: 39rpx; box-sizing: border-box; background: #d18a6e; box-shadow: 0 11rpx 0 #92573f, 0 18rpx 0 #734b2720; font-size: 38rpx; }
.bento-shell.box-mint { background: #9ab088; border-color: #60774e; box-shadow: 0 11rpx 0 #60774e, 0 18rpx 0 #734b2720; }
.bento-shell.box-sunshine { background: #e7bf65; border-color: #a17e36; box-shadow: 0 11rpx 0 #a17e36, 0 18rpx 0 #734b2720; }
.bento-shell.box-round { border-radius: 50%; padding-bottom: 100%; }
.bento-board { position: absolute; top: 5.5%; right: 5%; bottom: 6.5%; left: 5%; overflow: hidden; border: 2rpx solid #ad7751; border-radius: 26rpx; background: radial-gradient(ellipse at 45% 40%, #fff7da, #ebd7ae); box-shadow: inset 0 5rpx 0 #b78c5c3b; }
.box-round .bento-board { border-radius: 50%; }
.box-mint .bento-board { border-color: #7a8a57; }
.box-sunshine .bento-board { border-color: #b89548; }
.bento-rim-shine { position: absolute; left: 15%; right: 15%; top: 2%; height: 1.3%; border-radius: 99rpx; background: #ffffff30; pointer-events: none; }
.box-round .bento-rim-shine { display: none; }
.bento-empty { position: absolute; top: 50%; left: 50%; width: 84%; transform: translate(-50%, -50%); display: flex; align-items: center; flex-direction: column; gap: 7rpx; color: #ad946b; font-size: 22rpx; text-align: center; pointer-events: none; }
.bento-empty-mark { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border: 2rpx dashed #c6ac80; border-radius: 50%; font-size: 48rpx; line-height: 1; color: #ba9e6c; }
.bento-portion { position: absolute; width: 28%; height: 30%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; box-sizing: border-box; z-index: 2; }
.portion-selected { border: 3rpx dashed #8e6543; border-radius: 27%; background: #fffaf02e; z-index: 3; }
.portion-selection-dot { position: absolute; right: -5rpx; bottom: -5rpx; width: 13rpx; height: 13rpx; background: #a96543; border: 2rpx solid #fff5d8; border-radius: 50%; }
.food-art { position: relative; width: 80%; height: 80%; pointer-events: none; }
.food-rice { width: 82%; height: 77%; border-radius: 40% 42% 32% 32%; background: #fffdf2; border: 2rpx solid #d9cdb0; box-shadow: 0 5rpx 0 #b5a07a4a; transform: rotate(-5deg); }
.rice-nori { position: absolute; bottom: -1%; left: 32%; width: 37%; height: 38%; background: repeating-linear-gradient(90deg, #3d5131 0, #3d5131 3rpx, #4f613a 3rpx, #4f613a 5rpx); border-radius: 15% 15% 4% 4%; }
.rice-grain { position: absolute; width: 6%; height: 13%; border-radius: 50%; background: #eae5d5; transform: rotate(28deg); }
.rice-grain-one { left: 25%; top: 25%; }
.rice-grain-two { right: 21%; top: 34%; transform: rotate(-30deg); }
.rice-grain-three { left: 44%; top: 12%; transform: rotate(55deg); }
.food-rice.food-style-bear { background: #eee0bc; border-color: #cdb783; border-radius: 44%; transform: rotate(5deg); }
.rice-ear { position: absolute; top: -14%; width: 28%; height: 30%; border-radius: 50%; background: #e1c68e; border: 2rpx solid #bea475; z-index: -1; }
.rice-ear-left { left: 3%; }.rice-ear-right { right: 3%; }
.rice-face { position: absolute; top: 25%; left: 0; right: 0; text-align: center; font-size: .77em; font-weight: 800; color: #70543a; line-height: 1.3; white-space: nowrap; }
.food-egg { width: 85%; height: 70%; border-radius: 45% 49% 43% 37%; border: 2rpx solid #dbcaa4; background: #fffbe9; transform: rotate(-18deg); box-shadow: 0 4rpx 0 #c0a56d40; }
.egg-yolk { position: absolute; left: 29%; top: 23%; width: 45%; height: 53%; background: #f7c54c; border: 2rpx solid #dca235; border-radius: 50%; box-shadow: inset 2rpx 3rpx 0 #ffdd77; }
.food-egg.food-style-star { border: none; box-shadow: none; background: none; transform: rotate(8deg); }
.food-style-star .egg-yolk { display: none; }
.egg-star { position: absolute; display: flex; align-items: center; justify-content: center; top: -30%; bottom: -30%; left: -10%; right: -10%; color: #f2bf47; text-shadow: 1rpx 3rpx 0 #c49433; font-size: 2.3em; line-height: 1; }
.food-broccoli { height: 86%; transform: rotate(9deg); }
.broccoli-stem { position: absolute; left: 39%; top: 35%; height: 56%; width: 26%; background: #a2b75d; border: 2rpx solid #718d42; border-radius: 20%; transform: rotate(-5deg); }
.broccoli-floret { position: absolute; border-radius: 46%; background: radial-gradient(circle at 35% 25%, #8ca84d, #527d37); border: 2rpx solid #58723a; box-shadow: inset -3rpx -4rpx 0 #3b66222a; }
.broccoli-floret-left { top: 18%; left: 0; width: 49%; height: 48%; transform: rotate(-15deg); }
.broccoli-floret-right { top: 17%; right: 0; width: 49%; height: 48%; transform: rotate(15deg); }
.broccoli-floret-top { top: 0; left: 24%; width: 54%; height: 56%; }
.food-corn { width: 75%; height: 90%; transform: rotate(20deg); }
.corn-cob { position: absolute; top: 0; bottom: 11%; left: 21%; width: 57%; border-radius: 42% 42% 35% 35%; background: repeating-linear-gradient(0deg, transparent 0, transparent 12%, #c1913438 13%, #c1913438 16%), repeating-linear-gradient(90deg, #f4c849 0, #f4c849 24%, #e4b439 25%, #e4b439 29%); border: 2rpx solid #c99b34; box-shadow: inset 4rpx 0 0 #ffe071; }
.corn-leaf { position: absolute; bottom: 0; width: 36%; height: 55%; background: #8f9b53; border: 2rpx solid #788945; border-radius: 10% 90% 10% 90%; z-index: 1; }
.corn-leaf-left { left: 10%; transform: rotate(-12deg); }.corn-leaf-right { right: 9%; transform: rotate(51deg); }
.food-carrot { width: 68%; height: 95%; transform: rotate(-22deg); }
.carrot-root { position: absolute; top: 20%; left: 12%; width: 69%; height: 74%; background: #e58b42; border: 2rpx solid #bf6d32; border-radius: 34% 34% 54% 54% / 18% 18% 79% 79%; box-shadow: inset 5rpx 2rpx 0 #f4a75d; }
.carrot-leaf { position: absolute; width: 19%; height: 33%; top: 0; left: 30%; border-radius: 70% 30% 10% 10%; background: #6b9247; border: 2rpx solid #58823d; transform: rotate(-22deg); }
.carrot-leaf-right { left: 51%; transform: rotate(25deg); }
.carrot-mark { position: absolute; width: 32%; height: 5%; border-radius: 90%; background: #c36b2f; left: 7%; }
.carrot-mark-one { top: 31%; }.carrot-mark-two { top: 58%; left: auto; right: 6%; }
.food-strawberry { width: 72%; height: 88%; transform: rotate(12deg); }
.strawberry-fruit { position: absolute; top: 18%; bottom: 1%; left: 1%; right: 1%; border-radius: 38% 38% 51% 51% / 30% 30% 70% 70%; background: #d56850; border: 2rpx solid #a8453b; box-shadow: inset 5rpx 3rpx 0 #e38167; overflow: hidden; }
.strawberry-seeds { position: absolute; top: 5%; left: 5%; right: 5%; text-align: center; color: #ffd78f; font-size: 1em; font-weight: 800; line-height: .65; }
.strawberry-seeds text { display: block; }
.strawberry-crown { position: absolute; top: -21%; left: 0; right: 0; text-align: center; color: #6f8b42; font-size: 1.5em; font-weight: 900; line-height: 1; }
.bento-decoration { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; z-index: 4; }
.bento-decoration text { position: absolute; line-height: 1; }
.bento-decoration text:nth-child(1) { top: 18%; left: 28%; }.bento-decoration text:nth-child(2) { top: 65%; left: 69%; }.bento-decoration text:nth-child(3) { top: 70%; left: 27%; }
.decoration-sesame { color: #715738; font-size: .45em; }.decoration-sesame text:nth-child(4) { top: 40%; left: 47%; }.decoration-sesame text:nth-child(5) { top: 47%; left: 75%; }.decoration-sesame text:nth-child(6) { top: 71%; left: 48%; }.decoration-sesame text:nth-child(7) { top: 28%; left: 65%; }.decoration-sesame text:nth-child(8) { top: 44%; left: 21%; }
.decoration-flower { color: #d38b78; font-size: .7em; text-shadow: 1rpx 2rpx 0 #fff5d6; }.decoration-star { color: #e7b348; font-size: .65em; text-shadow: 1rpx 1rpx 0 #a78334; }

/* A three-card chalkboard sits above the personal recipe book. */
.recipe-book { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.signature-board { border: 9rpx solid #a07852; border-radius: 17rpx; padding: 25rpx 20rpx 24rpx; background: #536343; box-shadow: 0 6rpx 0 #705239, inset 0 0 0 2rpx #384a31; color: #fff9e8; }
.signature-heading { display: flex; justify-content: space-between; align-items: center; }
.signature-eyebrow { display: block; font-size: 18rpx; color: #d6dec5; letter-spacing: 5rpx; }
.signature-title { display: block; font-family: "STKaiti", "KaiTi", "Kaiti SC", serif; font-size: 38rpx; font-weight: 800; margin-top: 4rpx; }
.signature-flower { color: #e8cb8b; font-size: 61rpx; transform: rotate(12deg); }
.signature-subtitle { display: block; margin-top: 6rpx; font-size: 20rpx; color: #d3ddc6; }
.signature-slots { display: flex; gap: 12rpx; margin-top: 30rpx; }
.signature-slot { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; flex-direction: column; min-height: 232rpx; padding: 20rpx 10rpx 6rpx; border-radius: 4rpx; background: #fcf1d6; color: #6d573d; box-shadow: 3rpx 4rpx 0 #2d3c2866; }
.signature-slot:nth-child(1) { transform: rotate(-3deg); }.signature-slot:nth-child(3) { transform: rotate(3deg); }
.signature-clip { position: absolute; top: -13rpx; width: 41rpx; height: 22rpx; background: #d4b876c7; transform: rotate(-4deg); }
.signature-preview { width: 90%; padding: 6rpx 0 13rpx; }
.signature-preview .bento-shell { font-size: 11rpx; border-width: 1rpx; border-radius: 13rpx; box-shadow: 0 4rpx 0 #92573f; }
.signature-preview .box-round { border-radius: 50%; }
.signature-preview .bento-board { border-width: 1rpx; border-radius: 9rpx; }.signature-preview .box-round .bento-board { border-radius: 50%; }
.signature-preview .food-art, .signature-preview .food-art view { border-width: 1rpx; }
.signature-name { width: 100%; text-align: center; font-size: 21rpx; line-height: 1.4; font-weight: 800; overflow-wrap: anywhere; }
.restaurant-page .signature-remove { margin-top: auto; min-height: 54rpx; padding: 10rpx 0; font-size: 17rpx; color: #a08969; }
.signature-empty-icon { margin-top: 18rpx; font-size: 47rpx; line-height: 1.4; color: #c4b18b; }
.signature-empty-title { margin-top: 8rpx; font-size: 21rpx; font-weight: 700; color: #a18b64; }
.signature-empty-caption { font-size: 17rpx; color: #b6a17f; margin-top: 7rpx; text-align: center; }
.recipe-heading { margin-top: 35rpx; }
.recipe-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.recipe-card { width: calc((100% - 18rpx) / 2); border: 2rpx solid #dac6a5; border-bottom-width: 5rpx; border-radius: 19rpx; overflow: hidden; box-sizing: border-box; background: #fffaed; }
.recipe-art { position: relative; padding: 37rpx 31rpx 28rpx; background: repeating-linear-gradient(90deg, #ead9b61f 0, #ead9b61f 16rpx, transparent 16rpx, transparent 32rpx), #f0e4ca; }
.recipe-art .bento-shell { font-size: 19rpx; border-width: 2rpx; border-radius: 23rpx; box-shadow: 0 7rpx 0 #92573f; }.recipe-art .box-round { border-radius: 50%; }.recipe-art .bento-board { border-radius: 15rpx; }.recipe-art .box-round .bento-board { border-radius: 50%; }
.recipe-signature-badge { position: absolute; top: 9rpx; left: 10rpx; z-index: 1; padding: 3rpx 9rpx; border-radius: 6rpx; background: #63764c; color: #fff5d9; font-size: 17rpx; font-weight: 700; }
.recipe-card-body { padding: 17rpx 17rpx 14rpx; }
.recipe-name { display: block; color: #5b4730; font-size: 26rpx; font-weight: 800; line-height: 1.4; overflow-wrap: anywhere; }
.recipe-story { display: block; color: #9f8968; font-size: 18rpx; margin-top: 7rpx; line-height: 1.5; }
.recipe-feedback { display: block; margin-top: 10rpx; font-size: 20rpx; line-height: 1.5; color: #7d8961; }
.recipe-actions { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; }
.restaurant-page .recipe-cook { flex-shrink: 0; min-height: 61rpx; padding: 13rpx 17rpx; border-radius: 10rpx; background: #ecdfc4; color: #7c6242; font-size: 22rpx; font-weight: 700; }
.restaurant-page .recipe-signature-toggle { flex: 1; min-height: 61rpx; padding: 13rpx 0; color: #a77d40; font-size: 19rpx; text-align: right; }
.restaurant-page .is-signature { color: #71854f; }
.book-footer { display: block; margin-top: 27rpx; color: #a28b6a; text-align: center; font-size: 20rpx; }
.recipe-empty { display: flex; align-items: center; flex-direction: column; padding: 46rpx 20rpx 35rpx; border: 2rpx dashed #d8c5a1; border-radius: 20rpx; color: #a08b69; font-size: 24rpx; text-align: center; line-height: 1.7; }
.recipe-empty-icon { font-size: 69rpx; }
.recipe-empty-title { margin: 14rpx 0 10rpx; font-size: 29rpx; font-weight: 800; color: #755f40; }
.empty-newline { display: block; }.recipe-empty .primary-button { margin-top: 25rpx; font-size: 25rpx; }

/* Loading, recovery and keepsake overlays stay within a narrow phone. */
.status-note { display: flex; align-items: center; gap: 14rpx; padding: 19rpx 17rpx; margin-bottom: 20rpx; border: 2rpx solid #d7bc82; border-radius: 15rpx; background: #fff3d3; }
.status-icon { flex-shrink: 0; color: #aa6e36; font-size: 30rpx; font-weight: 800; }.status-copy { flex: 1; min-width: 0; font-size: 21rpx; color: #9b7c50; overflow-wrap: anywhere; }.status-title { display: block; font-size: 24rpx; font-weight: 800; color: #7e6039; margin-bottom: 4rpx; }
.restaurant-page .note-button { flex-shrink: 0; max-width: 130rpx; padding: 14rpx 13rpx; border: 2rpx solid #ccb184; border-radius: 10rpx; background: #fff9eb; color: #8a683d; font-size: 22rpx; font-weight: 700; }
.error-note { border-color: #ddb29a; background: #fae9dc; }.error-note .status-icon { width: 34rpx; height: 34rpx; line-height: 34rpx; border: 2rpx solid #b77a57; border-radius: 50%; text-align: center; font-size: 24rpx; }
.loading-card { display: flex; align-items: center; flex-direction: column; gap: 15rpx; padding: 130rpx 20rpx 150rpx; color: #a28d6d; font-size: 25rpx; text-align: center; }.loading-icon { font-size: 88rpx; animation: lunch-sway 1.8s ease-in-out infinite; }.loading-title { font-family: "STKaiti", "KaiTi", "Kaiti SC", serif; font-size: 34rpx; font-weight: 800; color: #796243; }
@keyframes lunch-sway { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg) translateY(-7rpx); } }
.ingredient-drag-ghost { position: fixed; z-index: 100; width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; transform: translate(-50%, -70%); border-radius: 27rpx; border: 3rpx solid #b7835f; background: #fff6dfda; box-shadow: 0 8rpx 0 #89633b28; font-size: 64rpx; pointer-events: none; }
.dialog-scrim { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; justify-content: center; align-items: center; padding: 30rpx; box-sizing: border-box; background: #44362680; }
.memory-card { position: relative; width: 100%; max-width: 650rpx; max-height: 87vh; overflow-y: auto; padding: 38rpx 35rpx 22rpx; border: 4rpx solid #9d7b53; border-radius: 14rpx 30rpx 14rpx 30rpx; background: #fff9e9; box-sizing: border-box; box-shadow: 9rpx 10rpx 0 #45332144; text-align: center; }
.memory-card-stamp { display: inline-block; padding: 3rpx 14rpx; color: #b57456; border: 2rpx solid #d3a486; border-radius: 7rpx; font-size: 21rpx; transform: rotate(-5deg); }.memory-card-heading { display: block; margin-top: 16rpx; font-family: "STKaiti", "KaiTi", "Kaiti SC", serif; font-weight: 800; color: #5e4931; font-size: 38rpx; }.memory-card-bento { width: 57%; margin: 25rpx auto 25rpx; }.memory-card-bento .bento-shell { font-size: 22rpx; }.memory-card-dish { display: block; font-size: 27rpx; color: #8f7050; font-weight: 800; overflow-wrap: anywhere; }.memory-card-feedback { display: block; margin-top: 17rpx; padding: 19rpx 14rpx; background: #eef0dd; border-radius: 13rpx; color: #697a4d; font-size: 26rpx; line-height: 1.65; }.memory-card-caption { display: block; margin-top: 16rpx; color: #aa9575; font-size: 20rpx; }.memory-card .primary-button { width: 100%; margin-top: 23rpx; }.restaurant-page .memory-save-button { width: 100%; min-height: 68rpx; padding: 18rpx 0 6rpx; color: #987755; font-size: 23rpx; }
.replace-card { width: 100%; max-width: 650rpx; max-height: 84vh; overflow-y: auto; padding: 27rpx 29rpx 17rpx; border: 3rpx solid #b3956d; border-radius: 27rpx; background: #fff9e9; box-sizing: border-box; text-align: center; }.replace-flower { color: #bf8062; font-size: 56rpx; }.replace-title { display: block; font-size: 35rpx; font-weight: 800; color: #655033; }.replace-description { display: block; margin: 18rpx 0 25rpx; color: #947e5c; font-size: 24rpx; line-height: 1.65; }.restaurant-page .replace-choice { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; width: 100%; min-height: 85rpx; margin-top: 13rpx; padding: 20rpx; border: 2rpx solid #ddc9a6; border-radius: 13rpx; background: #f5ecd5; font-size: 25rpx; text-align: left; }.replace-choice > text + text { flex-shrink: 0; color: #9f7450; font-size: 21rpx; }.restaurant-page .replace-cancel { width: 100%; margin-top: 12rpx; }
@media (max-width: 340px) { .restaurant-page { padding-left: 22rpx; padding-right: 22rpx; }.restaurant-title { font-size: 47rpx; }.section-aside { font-size: 20rpx; }.finishing-card { padding-left: 18rpx; padding-right: 18rpx; }.option-row { gap: 11rpx; }.restaurant-page .option-chip { padding-left: 12rpx; padding-right: 12rpx; }.color-options { gap: 7rpx; }.restaurant-page .color-swatch { width: 42rpx; height: 42rpx; }.serve-dock { gap: 10rpx; }.restaurant-page .serve-button { min-width: 240rpx; }.recipe-card-body { padding-left: 13rpx; padding-right: 13rpx; }.restaurant-page .recipe-cook { padding-left: 13rpx; padding-right: 13rpx; } }
@media (prefers-reduced-motion: reduce) { .loading-icon { animation: none; } }

.memory-pending { display: flex; align-items: center; gap: 14rpx; padding: 16rpx; margin-top: 16rpx; border: 2rpx solid #d7bc82; border-radius: 12rpx; background: #fff1d0; color: #9b7c50; font-size: 21rpx; text-align: left; }.memory-pending > text { flex: 1; min-width: 0; }.memory-error { display: block; margin-top: 14rpx; color: #a5654c; font-size: 21rpx; line-height: 1.6; }
.signature-preview .box-mint { box-shadow: 0 4rpx 0 #60774e; }.signature-preview .box-sunshine { box-shadow: 0 4rpx 0 #a17e36; }.recipe-art .box-mint { box-shadow: 0 7rpx 0 #60774e; }.recipe-art .box-sunshine { box-shadow: 0 7rpx 0 #a17e36; }
/* Give small decorative controls a generous touch area on children's phones. */
.restaurant-page .tiny-button { min-height: 88rpx; padding: 20rpx 15rpx; display: flex; align-items: center; justify-content: center; }
.restaurant-page .remove-portion { min-width: 88rpx; min-height: 88rpx; padding: 20rpx 12rpx; display: flex; align-items: center; justify-content: center; }
.restaurant-page .option-chip { min-height: 82rpx; }
.option-row { align-items: flex-start; }
.option-row > .option-label { padding-top: 24rpx; }
.color-options { gap: 4rpx; }
.restaurant-page .color-swatch { position: relative; width: 82rpx; height: 82rpx; border: none; box-shadow: none; background: transparent; }
.restaurant-page .color-swatch::before { content: ""; position: absolute; width: 45rpx; height: 45rpx; left: 50%; top: 50%; transform: translate(-50%, -50%); border: 3rpx solid transparent; border-radius: 50%; box-shadow: inset 0 0 0 4rpx #fff9ec; }
.restaurant-page .swatch-peach::before { background: #d99276; }.restaurant-page .swatch-mint::before { background: #91ad83; }.restaurant-page .swatch-sunshine::before { background: #e2ba59; }
.restaurant-page .color-swatch-selected::before { border-color: #634c37; }
.color-swatch > text { position: relative; z-index: 1; }
