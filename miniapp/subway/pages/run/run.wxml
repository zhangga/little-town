<view class="runner-page">
  <view class="run-topbar"><button class="run-back" bindtap="onBack" aria-label="返回地铁站">‹ 站台</button><view class="run-brand"><text class="run-line">01</text> STARLIGHT RUN</view><button class="run-shop-link" bindtap="onOpenShop" disabled="{{!economy}}">星光商店</button></view>
  <view class="run-hud"><view class="run-score"><text>本次得分</text><view>{{score}}</view></view><view class="run-stat"><text>金币</text><view class="run-coins">◉ {{coins}}</view></view><view class="run-stat"><text>星星</text><view class="run-stars">✦ {{stars}}</view></view><button class="run-pause" bindtap="onPause" disabled="{{phase !== 'running' && phase !== 'caught'}}" aria-label="暂停游戏">Ⅱ</button></view>
  <view class="run-chase {{chaseSeconds ? 'is-close' : ''}}"><view><text class="chase-dot" />{{chaseLabel}}<text wx:if="{{chaseSeconds}}"> · {{chaseSeconds}} 秒后甩开</text></view><text>{{distance}} m</text></view>
  <view class="run-stage">
    <canvas id="runner-canvas" type="2d" class="run-canvas" hidden="{{(phase !== 'running' && phase !== 'caught') || shopOpen}}" disable-scroll="{{true}}" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel" aria-label="三条城市轨道。左右滑动换道，上滑跳跃，下滑蹲下。" />
    <view wx:if="{{phase !== 'running' && phase !== 'caught' && !shopOpen}}" class="run-overlay">
      <view wx:if="{{phase === 'ready'}}" class="run-card run-intro">
        <view class="run-eyebrow">LITTLE TOWN / 城市追逐赛</view><view class="run-card-title">星光<text>疾驰</text><view class="title-arrow">↗</view></view>
        <view class="metro-hero" aria-hidden="true"><view class="hero-sun"/><view class="hero-rail rail-a"/><view class="hero-rail rail-b"/><view class="hero-rail rail-c"/><view class="hero-train"><view/><text>01</text></view><view class="hero-token token-a">◉</view><view class="hero-token token-b">✦</view><view class="hero-token token-c">◉</view><text class="hero-tag">RUN · JUMP · SURF</text></view>
        <view class="run-card-intro">甩开巡逻员，踩上弹跳板。<br/>装满金币，带一份礼物回小镇。</view>
        <view class="run-instructions"><view><text>↔</text>换道躲车</view><view><text>↑ ↓</text>跳跃 / 下滑</view><view><text>▰</text>滑板挡撞</view></view>
        <view class="run-best"><text>最佳 {{best}}</text><text>星光币 ◉ {{economy.tokens || 0}}</text></view>
        <button wx:if="{{pendingReward}}" class="run-primary" bindtap="onSettle" disabled="{{economyBusy}}">{{economyBusy ? '结算中…' : '领取上一程星光币'}}</button>
        <button wx:else class="run-primary" bindtap="onStart" disabled="{{!canvasReady || economyBusy}}">{{economyBusy ? '正在准备…' : canvasReady ? '出发跑酷 →' : '正在铺好跑道…'}}</button>
        <text class="run-footnote">每局送 1 次滑板 · 免费游玩</text>
      </view>
      <view wx:elif="{{phase === 'paused'}}" class="run-card run-card-compact"><view class="run-eyebrow">TAKE A BREATHER</view><view class="run-card-title small-title">歇一下，再出发。</view><view class="run-result-score">{{score}}<text>当前得分</text></view><view class="run-result-stats"><text>◉ {{coins}} 金币</text><text>✦ {{stars}} 星星</text></view><button class="run-primary" bindtap="onResume" disabled="{{!canvasReady || economyBusy}}">继续奔跑 →</button><button class="run-secondary" bindtap="onEndRun" disabled="{{economyBusy}}">结束本程并结算</button></view>
      <view wx:elif="{{phase === 'over'}}" class="run-card run-card-compact"><view class="run-eyebrow">{{newRecord ? 'NEW PERSONAL BEST' : 'ONE MORE ADVENTURE'}}</view><view class="run-card-title small-title">这一程，真精彩。</view><view class="run-result-score">{{score}}<text>本次得分 · {{distance}} 米</text></view><view class="run-result-stats"><text>◉ {{coins}} 金币</text><text>✦ {{stars}} 星星</text></view><view class="run-receipt"><text>{{awarded === null ? '待结算星光币' : '星光币已入账'}}</text><text>+{{awarded === null ? runTokens : awarded}}</text></view><text wx:if="{{awarded !== null && awarded < runTokens}}" class="run-footnote">已达到单局或今日奖励上限，仍可继续挑战。</text><button wx:if="{{pendingReward}}" class="run-primary" bindtap="onSettle" disabled="{{economyBusy}}">{{economyBusy ? '正在结算…' : '重试领取星光币'}}</button><button wx:else class="run-primary" bindtap="onStart" disabled="{{!canvasReady || economyBusy}}">{{economyBusy ? '准备中…' : '再跑一次 →'}}</button><button class="run-secondary" bindtap="onOpenShop">去星光商店兑换</button></view>
      <view wx:else class="run-card run-card-compact"><view class="run-eyebrow">STARLIGHT STATION</view><view class="run-card-title small-title">{{phase === 'loading' ? '星光号准备中…' : phase === 'locked' ? '先建一座地铁站' : phase === 'login' ? '欢迎来到星光环线' : '站台暂时没连上'}}</view><view class="run-card-intro">{{phase === 'loading' ? '正在连接站台与星光币钱包' : phase === 'locked' ? '在建造页用 15 砖块把地铁站带到小镇。' : phase === 'login' ? '登录后，从自己的小镇出发。' : error}}</view><button wx:if="{{phase === 'locked'}}" class="run-primary" bindtap="onGoBuild">去建造 →</button><button wx:elif="{{phase === 'error'}}" class="run-primary" bindtap="onRetry">重新连接</button><button wx:elif="{{phase === 'login'}}" class="run-primary" bindtap="onLogin">去登录</button></view>
    </view>
    <scroll-view wx:if="{{shopOpen}}" scroll-y class="run-shop">
      <view class="shop-heading"><view><text class="run-eyebrow">THE STARLIGHT STORE</text><view>把快乐带回家</view></view><button bindtap="onCloseShop" aria-label="关闭星光商店">×</button></view>
      <view class="shop-wallet"><view><text>我的星光币</text><view>◉ {{economy.tokens}}</view></view><text>今日获得 {{economy.earned_today}} / {{economy.daily_cap}}</text></view>
      <view class="shop-town-wallet">小镇钱包 <text>金币 {{economy.wallet.coins}} · 砖块 {{economy.wallet.bricks}}</text></view>
      <view class="shop-rule">沿途金币 1 枚 = 1 星光币，星星 1 颗 = 5 星光币。每局最多结算 500，今日最多 1000。</view>
      <view class="shop-item" wx:for="{{economy.items}}" wx:key="id"><view class="shop-item-art {{item.kind === 'skin' ? 'board-art' : ''}}" style="--item-color:{{item.color}}"><text>{{item.kind === 'skin' ? '▰' : item.id === 'coins' ? '◉' : '▦'}}</text></view><view class="shop-item-copy"><view>{{item.name}}</view><text>{{item.description}}</text><button data-id="{{item.id}}" bindtap="onShopItem" disabled="{{economyBusy || item.equipped}}">{{item.equipped ? '已装备' : item.owned ? '装备滑板' : item.price + ' 星光币 · ' + (item.kind === 'exchange' ? '兑换' : '购买')}}</button></view></view>
      <view class="shop-rule">所有滑板保护效果相同。兑换的小镇金币可去商场购买家具、吃喝和装扮。</view><text wx:if="{{shopMessage}}" class="shop-success">{{shopMessage}}</text>
    </scroll-view>
    <view wx:if="{{economyError}}" class="run-error"><text>{{economyError}}</text><button wx:if="{{pendingReward && !economyBusy}}" bindtap="onDiscardReward">放弃本次结算</button></view>
    <button wx:if="{{canvasError}}" class="run-canvas-retry" bindtap="onRetryCanvas">{{canvasError}}</button>
  </view>
  <view class="run-controls"><view class="run-hint">{{phase === 'running' ? hint : '撞路障会被追近 · 撞车辆直接被抓'}}</view><view class="run-control-buttons"><button data-action="left" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="向左换道"><text>←</text>左移</button><button data-action="jump" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="跳跃"><text>↑</text>跳跃</button><button data-action="slide" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="下滑"><text>↓</text>下滑</button><button data-action="right" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="向右换道"><text>→</text>右移</button><button class="board-control {{boardSeconds ? 'board-active' : ''}}" data-action="board" bindtap="onControl" disabled="{{phase !== 'running' || (!boards && !boardSeconds)}}" aria-label="启动滑板抵挡一次碰撞"><text>▰</text>{{boardSeconds ? boardSeconds + 's' : '滑板 ' + boards}}</button></view><view wx:if="{{magnetSeconds}}" class="magnet-timer">磁铁吸币中 · {{magnetSeconds}}s</view></view>
</view>
