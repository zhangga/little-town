<view class="runner-page">
  <view class="run-topbar"><button class="run-back" bindtap="onBack" aria-label="返回地铁站">‹ 站台</button><view class="run-brand"><text class="run-line">01</text><text>星光环线</text></view><button class="run-pause" bindtap="onPause" disabled="{{phase !== 'running'}}" aria-label="暂停游戏">Ⅱ 暂停</button></view>
  <view class="run-hud"><view class="run-score"><text>本次得分</text><view>{{score}}</view></view><view class="run-stat"><text>路程</text><view>{{distance}}<text> 米</text></view></view><view class="run-stat"><text>星星</text><view class="run-stars">✦ {{stars}}</view></view><view class="run-stat"><text>体力</text><view class="run-hearts" aria-label="{{'剩余体力 ' + hearts}}">{{hearts}}</view></view></view>
  <view class="run-stage">
    <canvas id="runner-canvas" type="2d" class="run-canvas" hidden="{{phase !== 'running'}}" disable-scroll="{{true}}" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel" aria-label="三条轨道的跑酷场景，用下方按钮或滑动屏幕操作" />
    <view wx:if="{{phase === 'running'}}" class="run-pace">{{pace}} <text>→</text></view>
    <view wx:if="{{phase !== 'running'}}" class="run-overlay">
      <view class="run-card" wx:if="{{phase === 'ready'}}">
        <view class="run-eyebrow">LITTLE TOWN · METRO RUN</view><view class="run-card-title"><view>下一站，</view><view>去冒险。</view></view><view class="run-card-intro"><view>踏上星光环线，</view><view>把沿途的小星星装进口袋。</view></view>
        <view class="run-instructions"><view><text>↔</text><view>左右换道<text>绕开前方列车</text></view></view><view><text>↑</text><view>向上跳跃<text>跳过橙色路障</text></view></view><view><text>↓</text><view>向下滑行<text>穿过绿色横杆</text></view></view></view>
        <view class="run-best">个人最佳 <text>{{best}}</text></view>
        <button class="run-primary" bindtap="onStart" disabled="{{!canvasReady}}">{{canvasReady ? '出发跑酷 →' : '正在铺好跑道…'}}</button><text class="run-footnote">免费游玩 · 3 颗爱心 · 星星只计本局分数</text>
      </view>
      <view class="run-card run-card-compact" wx:elif="{{phase === 'paused'}}"><view class="run-eyebrow">TAKE A LITTLE BREAK</view><view class="run-card-title">在这里歇歇脚</view><view class="run-card-intro">跑道和星星都在等你，准备好再出发。</view><view class="run-result-score">{{score}}<text>当前得分</text></view><button class="run-primary" bindtap="onResume" disabled="{{!canvasReady}}">继续奔跑 →</button><button class="run-secondary" bindtap="onBack">返回站台</button></view>
      <view class="run-card run-card-compact" wx:elif="{{phase === 'over'}}"><view class="run-eyebrow">{{newRecord ? 'NEW PERSONAL BEST' : 'A LOVELY LITTLE JOURNEY'}}</view><view class="run-card-title">{{newRecord ? '新的最好成绩！' : '这一程，真棒！'}}</view><view class="run-result-score">{{score}}<text>本次得分</text></view><view class="run-result-stats"><text>跑了 {{distance}} 米</text><text>收集 {{stars}} 颗星星</text></view><view class="run-best">个人最佳 <text>{{best}}</text></view><text wx:if="{{recordSaveFailed}}" class="run-storage-note">成绩暂时没存好，本次仍可继续玩。</text><button class="run-primary" bindtap="onStart" disabled="{{!canvasReady}}">再跑一次 →</button><button class="run-secondary" bindtap="onBack">返回站台</button></view>
      <view class="run-card run-card-compact" wx:else><view class="run-eyebrow">LITTLE TOWN METRO</view><view class="run-card-title">{{phase === 'loading' ? '星光号准备中…' : phase === 'locked' ? '先建一座地铁站' : phase === 'login' ? '欢迎来到星光环线' : '站台暂时没连上'}}</view><view class="run-card-intro">{{phase === 'loading' ? '正在确认你的小镇站台' : phase === 'locked' ? '去建造页，用 15 砖块把地铁站带到小镇。' : phase === 'login' ? '登录后，就能从自己的地铁站出发。' : error}}</view><button wx:if="{{phase === 'locked'}}" class="run-primary" bindtap="onGoBuild">去建造地铁站 →</button><button wx:elif="{{phase === 'error'}}" class="run-primary" bindtap="onRetry">再试一次</button><button wx:elif="{{phase === 'login'}}" class="run-primary" bindtap="onLogin">去登录</button><button wx:if="{{phase !== 'loading'}}" class="run-secondary" bindtap="onBack">返回小镇</button></view>
    </view>
    <button wx:if="{{canvasError}}" class="run-canvas-retry" bindtap="onRetryCanvas">{{canvasError}}</button>
  </view>
  <view class="run-controls"><view class="run-hint">{{phase === 'running' ? hint : '滑动跑道，或点击下方按钮操作'}}</view><view class="run-control-buttons"><button data-action="left" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="向左换道"><text>←</text>左移</button><button data-action="jump" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="跳跃"><text>↑</text>跳跃</button><button data-action="slide" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="下滑"><text>↓</text>下滑</button><button data-action="right" bindtap="onControl" disabled="{{phase !== 'running'}}" aria-label="向右换道"><text>→</text>右移</button></view></view>
</view>
