/* app.wxss — 小小镇全局样式
   视觉语言：积木 / 木刻。粗描边 + 硬阴影（无模糊）。
   硬阴影用 8rpx 8rpx 0 而不是灰柔光，是为了让面板"立"在草地上像积木块。
*/

page {
  background-color: #7FBF4D;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #33291D;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------- 结构装置 ---------- */

.ink {
  border: 4rpx solid #33291D;
}

.block {
  background: #FFFCF2;
  border: 4rpx solid #33291D;
  box-shadow: 8rpx 8rpx 0 #33291D;
}

.block-sm {
  background: #FFFCF2;
  border: 4rpx solid #33291D;
  box-shadow: 6rpx 6rpx 0 #33291D;
}

/* 面板：主内容容器 */
.panel {
  background: #FFFCF2;
  border: 4rpx solid #33291D;
  border-radius: 20rpx;
  box-shadow: 8rpx 8rpx 0 #33291D;
  padding: 32rpx;
  margin: 24rpx;
}

/* 标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #33291D;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #33291D;
  margin-bottom: 20rpx;
}

.caption {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #8A8172;
}

/* ---------- 按钮 ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #33291D;
  border-radius: 999rpx;
  box-shadow: 6rpx 6rpx 0 #33291D;
  font-size: 32rpx;
  font-weight: 800;
  padding: 24rpx 56rpx;
  background: #FFFCF2;
  color: #33291D;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

/* 按下：阴影收回，视觉上被按进去 */
.btn:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: 2rpx 2rpx 0 #33291D;
}

.btn-primary {
  background: #E0553A;
  color: #FFFCF2;
}

.btn-sun {
  background: #FFC93C;
  color: #33291D;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn[disabled] {
  background: #D8D2C4;
  color: #8A8172;
  box-shadow: 6rpx 6rpx 0 #8A8172;
  border-color: #8A8172;
}

/* ---------- 资源条（金币 / 砖块） ---------- */

.resource-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFFCF2;
  border: 4rpx solid #33291D;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  box-shadow: 4rpx 4rpx 0 #33291D;
}

.chip-num {
  font-size: 32rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.chip-icon {
  font-size: 30rpx;
  line-height: 1;
}

.coin-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* ---------- 工具类 ---------- */

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.gap-32 { gap: 32rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }

.flex-1 { flex: 1; }

.tnum {
  font-variant-numeric: tabular-nums;
}

/* 方块小镇：4 × 4 图集，每个容器只露出一个方形单元。 */
.voxel-sprite {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}
.voxel-atlas {
  position: absolute;
  width: 400%;
  height: 400%;
  max-width: none;
}

.voxel-icon {
  display: block;
  width: 100%;
  height: 100%;
}

/* 空状态：邀请行动，不卖惨 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 120rpx;
  line-height: 1;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #33291D;
  max-width: 480rpx;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 80rpx;
}

.loading-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #33291D;
}

/* 硬阴影降级：低版本无 gap 时用 margin */
@supports not (gap: 8rpx) {
  .chip + .chip { margin-left: 16rpx; }
}
.art-sprite { position: relative; width: 100%; height: 100%; overflow: hidden; }
.art-atlas { position: absolute; max-width: none; pointer-events: none; }
