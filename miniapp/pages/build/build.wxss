page { background: #f4efdf; }
.build-page { min-height: 100vh; padding: 28rpx 28rpx 156rpx; box-sizing: border-box; color: #342d22; }
.build-page button { margin: 0; padding: 0; color: inherit; font-weight: 700; border-radius: 12rpx; }
.build-page button::after { border: none; }
.workshop-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.eyebrow { font-size: 17rpx; letter-spacing: 2rpx; color: #756f5d; font-weight: 700; }
.workshop-title { font-size: 40rpx; font-weight: 900; letter-spacing: 1rpx; }
.build-page .town-link { font-size: 23rpx; background: transparent; line-height: 2; padding: 12rpx 0 12rpx 12rpx; }
.inventory { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 22rpx 12rpx 10rpx; background: #fffcf3; border: 3rpx solid #4b4935; border-radius: 16rpx; box-shadow: 0 6rpx 0 #dad3bb; }
.inventory-main { display: flex; align-items: center; gap: 10rpx; }
.resource-art { width: 96rpx; height: 96rpx; }
.inventory-label { font-size: 21rpx; color: #776d58; }
.inventory-count { font-size: 44rpx; line-height: 1.12; font-weight: 900; font-variant-numeric: tabular-nums; }
.unit { font-size: 22rpx; font-weight: 600; }
.inventory-coins { display: flex; align-items: center; font-size: 23rpx; color: #77623d; }
.coin-art { width: 54rpx; height: 54rpx; }
.next-project { display: flex; position: relative; align-items: center; min-height: 258rpx; margin: 28rpx 0 32rpx; border: 3rpx solid #415237; border-radius: 16rpx; background: #dce9c5; box-shadow: 0 6rpx 0 #b9c99d; overflow: hidden; }
.project-copy { width: 59%; padding: 24rpx 0 24rpx 24rpx; z-index: 1; box-sizing: border-box; }
.project-kicker { font-size: 21rpx; color: #4f6643; font-weight: 700; }
.project-title { font-size: 36rpx; font-weight: 900; margin: 8rpx 0; }
.project-desc { display: block; font-size: 22rpx; color: #576847; max-width: 320rpx; }
.project-cta { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; font-weight: 800; margin-top: 20rpx; padding: 10rpx 16rpx; background: #fffcf3; border: 2rpx solid #798664; border-radius: 8rpx; }
.project-art { position: absolute; right: -10rpx; bottom: 2rpx; width: 300rpx; height: 300rpx; }
.catalog-heading { display: flex; justify-content: space-between; align-items: baseline; font-size: 32rpx; font-weight: 900; }
.catalog-count { font-size: 22rpx; color: #7e7663; font-weight: 500; }
.catalog-tabs { display: flex; gap: 12rpx; margin: 18rpx 0 22rpx; }
.build-page .catalog-tab { flex: 1; font-size: 23rpx; line-height: 66rpx; background: #e8e1ce; color: #716a56; border: 2rpx solid transparent; }
.build-page .catalog-tab.is-active { background: #394c36; color: #fffdf4; border-color: #253a27; }
.blueprint-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; }
.build-page .blueprint-card { width: 100%; text-align: left; background: #fffcf3; border: 3rpx solid #5b5845; border-radius: 14rpx; padding: 16rpx 20rpx 12rpx; box-shadow: 0 6rpx 0 #d9d0b9; line-height: 1.5; overflow: hidden; }
.blueprint-card:active { transform: translateY(4rpx); box-shadow: 0 2rpx 0 #d9d0b9; }
.card-state { display: inline-block; font-size: 19rpx; color: #85765e; background: #eee7d5; padding: 3rpx 10rpx; border-radius: 5rpx; }
.card-state.state-ready { color: #476233; background: #e0edcc; }
.card-state.state-built { color: #466669; background: #e0eeeb; }
.card-art { width: 192rpx; height: 192rpx; margin: -2rpx auto 0; }
.card-name { font-size: 30rpx; font-weight: 900; }
.card-caption { font-size: 21rpx; color: #8a806b; font-weight: 400; margin: 3rpx 0 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 2rpx solid #ede7d6; padding-top: 7rpx; }
.card-cost { display: flex; align-items: center; font-size: 24rpx; }
.mini-brick { width: 44rpx; height: 44rpx; margin-right: 6rpx; }
.card-arrow { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; font-size: 28rpx; background: #eee7d5; border-radius: 8rpx; }
.is-built .card-arrow { background: #e0edcc; color: #496738; }
.catalog-empty { padding: 60rpx 20rpx; text-align: center; font-size: 25rpx; color: #776d58; }
.catalog-empty .btn { margin: 28rpx auto 0; padding: 22rpx 32rpx; }
.catalog-footnote { font-size: 20rpx; line-height: 1.8; color: #8a806b; text-align: center; padding: 36rpx 10rpx; }
.collection-complete { margin: 28rpx 0; padding: 32rpx; background: #dce9c5; border-radius: 14rpx; }
.collection-complete text { display: block; font-size: 26rpx; font-weight: 700; }
.collection-complete text + text { font-size: 22rpx; margin-top: 12rpx; font-weight: 400; }
.loading-art { width: 160rpx; height: 160rpx; }
.workshop-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); background: #fffcf3; border-top: 2rpx solid #d8cfb7; }
.dock-title { font-size: 25rpx; font-weight: 800; }
.dock-caption { font-size: 20rpx; color: #8a806b; }
.build-page .workshop-dock button { flex-shrink: 0; padding: 20rpx 24rpx; font-size: 25rpx; line-height: 1.4; background: #f3c65c; border: 2rpx solid #5e4c2b; box-shadow: 0 4rpx 0 #bfa24e; }
.blueprint-mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; background: rgba(25, 35, 24, .55); }
.blueprint-sheet { display: flex; flex-direction: column; width: 100%; max-height: 94vh; box-sizing: border-box; padding: 22rpx 36rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fffcf3; border-top: 4rpx solid #4b4935; text-align: center; }
.sheet-body { height: 580rpx; max-height: 56vh; min-height: 0; flex-shrink: 1; }
.sheet-top, .sheet-actions { flex-shrink: 0; }
.sheet-top { display: flex; align-items: center; justify-content: space-between; font-size: 23rpx; color: #8a806b; }
.build-page .sheet-close { width: 64rpx; height: 64rpx; line-height: 60rpx; font-size: 40rpx; background: #ede7d7; border-radius: 50%; }
.sheet-art { width: 260rpx; height: 260rpx; margin: -4rpx auto 0; }
.sheet-title { font-size: 40rpx; font-weight: 900; }
.sheet-description { display: block; font-size: 24rpx; color: #82765d; margin: 8rpx 0 24rpx; }
.materials { border: 2rpx solid #e0d7bf; padding: 18rpx 22rpx; border-radius: 12rpx; background: #f5f0e2; }
.materials-heading, .material-name { display: flex; align-items: center; }
.materials-heading { justify-content: space-between; font-size: 25rpx; }
.material-count { font-size: 29rpx; font-weight: 900; }
.material-count.enough { color: #52763d; }
.material-track { height: 16rpx; background: #ded6be; border-radius: 4rpx; overflow: hidden; margin: 12rpx 0; }
.material-fill { height: 100%; background: #88b465; }
.material-hint { font-size: 22rpx; text-align: left; color: #817357; }
.sheet-actions { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; }
.build-page .sheet-primary { width: 100%; font-size: 28rpx; line-height: 1.5; padding: 24rpx 16rpx; color: #fffdf4; background: #46633c; border: 2rpx solid #2c4628; box-shadow: 0 5rpx 0 #2c4628; }
.build-page .sheet-primary[disabled] { background: #87987d; color: #f7f6ef; }
.build-page .sheet-secondary { font-size: 23rpx; background: transparent; line-height: 1.5; padding: 16rpx; color: #817357; }
.completion-note { padding: 22rpx 12rpx; font-size: 25rpx; color: #52763d; background: #e8f0d9; border-radius: 12rpx; }
.sheet-completed { background: #f7f9ed; }
.has-landed { animation: landed 550ms ease-out; }
.is-building { animation: building 700ms ease-in-out infinite alternate; }
@keyframes landed { 0% { transform: translateY(-40rpx) scale(.85); opacity: .4; } 65% { transform: translateY(5rpx) scale(1.04); } 100% { transform: translateY(0) scale(1); opacity: 1; } }
@keyframes building { from { transform: translateY(0); } to { transform: translateY(-12rpx); } }
@media (max-height: 520px) { .sheet-art { width: 188rpx; height: 188rpx; } .blueprint-sheet { padding-top: 12rpx; } .sheet-description { margin-bottom: 14rpx; } .sheet-body { height: 460rpx; } }
