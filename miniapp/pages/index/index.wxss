page { background: #cfe4b0; }
.town-page { height: 100vh; display: flex; flex-direction: column; color: #344330; background: #e5edd3; }
.town-page button { margin: 0; padding: 0; font-family: inherit; }
.town-page button::after { border: none; }
.town-topbar { display: flex; align-items: center; gap: 22rpx; padding: 14rpx 24rpx; background: #fffcf3; border-bottom: 2rpx solid #d1d9bd; }
.town-resource { display: flex; align-items: center; gap: 5rpx; font-size: 19rpx; color: #8a806b; }
.town-resource-art { width: 55rpx; height: 55rpx; }
.town-resource-num { font-size: 29rpx; font-weight: 900; color: #473b2c; font-variant-numeric: tabular-nums; }
.town-count { margin-left: auto; padding: 8rpx 16rpx; border-radius: 8rpx; background: #e5edda; font-size: 22rpx; font-weight: 700; }
.town-scroll { flex: 1; min-height: 0; }
.town-intro { padding: 36rpx 28rpx 30rpx; text-align: center; background: #e5edd3; }
.town-eyebrow { font-size: 17rpx; letter-spacing: 3rpx; color: #859573; }
.town-title { font-size: 44rpx; font-weight: 900; margin: 4rpx 0 10rpx; letter-spacing: 2rpx; }
.town-subtitle { font-size: 23rpx; color: #6e825c; }
.town-land { position: relative; margin: 0 16rpx; padding: 28rpx 10rpx 20rpx; border-radius: 100rpx 100rpx 28rpx 28rpx; border: 3rpx solid #8da951; border-bottom: 14rpx solid #7d9149; background: #92b84a; overflow: hidden; }
.land-meadow { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
.land-meadow-tile { display: block; width: 100%; height: 720rpx; }
.land-trees { position: absolute; right: -24rpx; top: -20rpx; width: 155rpx; height: 155rpx; pointer-events: none; }
.town-plots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24rpx 0; position: relative; }
.town-page .town-plot { position: relative; width: 100%; background: transparent; overflow: visible; line-height: 1.4; border-radius: 0; display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; }
.plot-art { width: 214rpx; height: 214rpx; max-width: 100%; }
.plot-label { margin-top: -6rpx; padding: 6rpx 18rpx; color: #4c5035; font-size: 22rpx; font-weight: 800; background: #fffaf0; border: 2rpx solid #a7ab83; border-radius: 8rpx; box-shadow: 0 4rpx 0 #aebd89; }
.plot-invite { padding: 7rpx 16rpx; font-size: 20rpx; font-weight: 800; color: #6c501b; border: 2rpx solid #c9982e; border-radius: 10rpx; background: #ffdc71; box-shadow: 0 4rpx 0 rgba(119,119,42,.3); }
.plot-empty-label { font-size: 20rpx; padding: 8rpx 12rpx; color: #765d24; background: #fff0b9; border: 2rpx solid #d7ba62; border-radius: 10rpx; }
.vacant-ground { position: relative; }
.build-area { position: absolute; left: 50%; top: 64%; width: 130rpx; height: 130rpx; box-sizing: border-box; transform: translate(-50%, -50%) scaleY(.55) rotate(45deg); border: 5rpx dashed #f8d36b; border-radius: 12rpx; background: rgba(255,227,128,.12); box-shadow: 0 0 0 3rpx rgba(108,124,40,.18); }
.build-marker { position: absolute; left: 50%; top: 64%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; border: 3rpx solid #ffe9a1; color: #7d5918; background: #f7ca52; font-size: 40rpx; font-weight: 900; line-height: 1; box-shadow: 0 5rpx 0 rgba(111,122,39,.24); }
.vacant-next .build-area { border-color: #ffe58c; background: rgba(255,226,109,.22); }
.vacant-next .build-marker { background: #ffdb65; }
.new-flag { position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 2; padding: 4rpx 12rpx; border-radius: 6rpx; background: #f8cb5c; color: #59441e; font-size: 19rpx; font-weight: 800; white-space: nowrap; }
.new-building .plot-art { animation: town-landed 600ms ease-out; }
@keyframes town-landed { from { opacity: 0; transform: translateY(-44rpx) scale(.8); } 70% { transform: translateY(6rpx) scale(1.04); } to { opacity: 1; transform: translateY(0) scale(1); } }
.town-sign { position: relative; text-align: center; font-size: 20rpx; color: #455e29; padding: 18rpx 0 10rpx; }
.town-sign text { display: inline-block; padding: 9rpx 16rpx; border-radius: 10rpx; background: rgba(248,250,222,.86); }
.town-first-plan { margin: 22rpx 24rpx 28rpx; padding: 22rpx; background: #fffcf0; border: 2rpx solid #b9c59b; border-radius: 12rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.first-plan-title { display: block; font-size: 26rpx; font-weight: 800; }
.first-plan-caption { display: block; font-size: 20rpx; color: #8a806b; margin-top: 6rpx; }
.town-page .town-first-plan button { flex-shrink: 0; font-size: 23rpx; padding: 12rpx 18rpx; color: #4b623a; background: #e3edce; border-radius: 8rpx; }
.town-dock { display: flex; flex-shrink: 0; gap: 20rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fffcf3; border-top: 2rpx solid #cad5b5; }
.town-page .town-dock button { flex: 1; font-size: 27rpx; font-weight: 800; border: 2rpx solid #536047; border-radius: 12rpx; line-height: 1.5; padding: 22rpx 10rpx; box-shadow: 0 5rpx 0 #c6ceb1; }
.town-learn { background: #f7edcf; color: #625739; }
.town-page .town-build { background: #496a3e; color: #fffdf3; box-shadow: 0 5rpx 0 #2d4927; }
.town-loading-art { width: 160rpx; height: 160rpx; }
.town-mask { position: fixed; inset: 0; z-index: 100; background: rgba(25,35,24,.55); display: flex; align-items: center; justify-content: center; padding: 40rpx; }
.town-detail { width: 100%; max-height: 85vh; overflow-y: auto; padding: 20rpx 36rpx 36rpx; box-sizing: border-box; border: 3rpx solid #4b4935; border-radius: 24rpx; background: #fffcf3; text-align: center; box-shadow: 0 8rpx 0 #344330; }
.detail-art { width: 280rpx; height: 280rpx; margin: auto; }
.detail-title { font-size: 40rpx; font-weight: 900; }
.detail-date { display: block; font-size: 21rpx; margin: 8rpx 0 20rpx; color: #8a806b; }
.detail-description { display: block; font-size: 26rpx; }
.detail-memory { padding: 20rpx 10rpx; margin: 24rpx 0; background: #e8f0d9; border-radius: 10rpx; font-size: 24rpx; color: #617d45; }
.town-page .town-detail button { font-size: 28rpx; line-height: 1.5; padding: 22rpx; font-weight: 800; background: #496a3e; color: #fffdf3; border-radius: 12rpx; }
.town-welcome { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx 4rpx 8rpx; }
.welcome-character { width: 145rpx; height: 145rpx; flex-shrink: 0; }
.welcome-copy { flex: 1; min-width: 0; }
.welcome-name { font-size: 32rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.welcome-copy text { font-size: 21rpx; color: #82916f; }
.welcome-meter { height: 8rpx; width: 80%; max-width: 240rpx; background: #d4ddc1; margin-top: 14rpx; border-radius: 8rpx; overflow: hidden; }
.welcome-meter view { height: 100%; background: #8ba86c; }
.town-page .town-welcome button { flex-shrink: 0; font-size: 22rpx; color: #5c7448; background: #f7faee; padding: 12rpx 18rpx; border-radius: 14rpx; }
.town-task { display: flex; align-items: center; gap: 12rpx; margin: 0 24rpx 26rpx; padding: 22rpx; border: 2rpx solid #d5dabe; border-radius: 20rpx; background: #fffbee; }
.town-task > view { flex: 1; min-width: 0; }
.task-title { font-size: 27rpx; font-weight: 800; }
.task-title text { margin-left: 16rpx; color: #8a9d62; font-size: 22rpx; }
.task-caption { display: block; font-size: 20rpx; color: #90937b; margin-top: 8rpx; line-height: 1.6; }
.town-page .town-task button { flex-shrink: 0; background: #f3cd68; color: #675325; border-radius: 12rpx; font-size: 23rpx; font-weight: 800; padding: 15rpx 18rpx; }
.plot-resident { position: absolute; right: -4rpx; bottom: 35rpx; width: 100rpx; height: 100rpx; }
.plot-garden { position: absolute; left: 0; bottom: 40rpx; width: 65rpx; height: 65rpx; }
.town-page .growth-retry { font-size: 23rpx; background: transparent; color: #687b53; }
.life-weather { display: flex; align-items: center; gap: 14rpx; margin: 0 28rpx 18rpx; }
.life-weather > text:first-child { font-size: 43rpx; }
.life-weather > view { flex: 1; min-width: 0; font-size: 24rpx; font-weight: 800; }
.life-weather > view > text { display: block; margin-top: 5rpx; font-size: 20rpx; line-height: 1.6; font-weight: 400; color: #72825d; }
.life-weather-note { writing-mode: vertical-rl; letter-spacing: 4rpx; font-size: 17rpx; color: #809267; padding: 8rpx; border-left: 2rpx solid #becda5; }
.town-evening { background-color: #789746; border-color: #718b48; }
.town-evening .land-meadow::after { content: ''; position: absolute; inset: 0; background: rgba(35,61,49,.12); }
.life-lane { height: 68rpx; position: relative; margin: 12rpx 12rpx 0; overflow: hidden; }
.life-walker { position: absolute; top: -22rpx; width: 100rpx; height: 100rpx; animation: life-stroll 22s linear infinite alternate; pointer-events: none; }
.life-walker-0 { left: 5%; }
.life-walker-1 { left: 35%; animation-delay: -11s; animation-duration: 28s; }
.life-roaming-pet { position: absolute; left: 18%; top: 12rpx; font-size: 34rpx; animation: life-stroll 22s linear infinite alternate; pointer-events: none; }
@keyframes life-stroll { from { transform: translateX(0); } to { transform: translateX(260rpx); } }
.plot-pets { position: absolute; left: 10rpx; bottom: 44rpx; font-size: 32rpx; display: flex; }
.plot-pets text { animation: life-bob 3s ease-in-out infinite; }
.plot-pets.pet-resting text { animation: none; opacity: .65; }
.plot-event { position: absolute; top: 10rpx; right: 14rpx; font-size: 27rpx; background: #fff8e7; border: 2rpx solid #d5ac6a; border-radius: 50%; width: 47rpx; height: 47rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 0 #a3b380; z-index: 2; animation: life-bob 3s ease-in-out infinite; }
@keyframes life-bob { 50% { transform: translateY(-5rpx); } }
.scene-paused .life-walker, .scene-paused .life-roaming-pet, .scene-paused .plot-pets text, .scene-paused .plot-event { animation-play-state: paused; }
.life-section-heading { display: flex; justify-content: space-between; align-items: center; margin: 30rpx 28rpx 16rpx; gap: 12rpx; }
.life-section-heading > view { font-size: 30rpx; font-weight: 900; display: flex; align-items: center; gap: 12rpx; }
.life-section-heading > text { font-size: 20rpx; color: #7a8767; }
.life-dot { width: 12rpx; height: 12rpx; background: #7ea55d; border-radius: 50%; }
.life-event { margin: 0 24rpx; padding: 24rpx; background: #fffcf1; border: 2rpx solid #c4cda9; border-radius: 22rpx; box-shadow: 0 6rpx 0 #d0d9b8; }
.life-event-help { background: #fff8e9; border-color: #d7bd89; }
.life-event-top { display: flex; align-items: center; gap: 16rpx; }
.life-event-top > view { flex: 1; min-width: 0; }
.life-event-icon { font-size: 44rpx; background: #f0e9cb; border-radius: 16rpx; padding: 10rpx; flex-shrink: 0; }
.life-kicker { font-size: 19rpx; color: #8c8e70; }
.life-event-title { margin-top: 5rpx; font-size: 29rpx; font-weight: 900; line-height: 1.4; }
.life-price { font-size: 20rpx; color: #997234; background: #f6e8c4; border-radius: 20rpx; padding: 7rpx 13rpx; flex-shrink: 0; }
.life-event-description { font-size: 24rpx; line-height: 1.8; color: #7d7d62; margin: 20rpx 0; }
.town-page .life-action { display: block; width: 100%; box-sizing: border-box; padding: 20rpx 16rpx; line-height: 1.6; font-size: 25rpx; font-weight: 800; background: #506e42; color: #fffcf1; border-radius: 12rpx; }
.town-page .life-action[disabled] { opacity: .55; }
.life-fineprint { display: block; text-align: center; margin-top: 13rpx; font-size: 19rpx; color: #a09577; }
.life-rule-note { margin: 17rpx 28rpx; font-size: 19rpx; color: #8a9475; text-align: center; }
.life-quiet { display: flex; align-items: center; gap: 20rpx; margin: 0 24rpx; padding: 26rpx; border: 2rpx dashed #b5c59c; border-radius: 18rpx; }
.life-quiet > text { font-size: 46rpx; }
.life-quiet > view > view { font-size: 26rpx; font-weight: 800; }
.life-quiet > view > text { display: block; margin-top: 8rpx; font-size: 22rpx; line-height: 1.7; color: #7f8e6a; }
.life-memory { margin: 20rpx 28rpx; padding-left: 20rpx; border-left: 4rpx solid #c3b979; }
.life-memory > text { font-size: 20rpx; color: #9c905c; }
.life-memory > view { margin-top: 10rpx; font-size: 22rpx; line-height: 1.8; color: #7d876c; }
.pet-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; padding: 0 24rpx; }
.town-page .pet-card { background: #fffcf1; border: 2rpx solid #c4cda9; border-radius: 22rpx; padding: 20rpx; line-height: 1.6; display: flex; flex-direction: column; align-items: center; color: #465639; text-align: center; }
.town-page .pet-card.pet-owned { background: #eaf0db; color: #465639; }
.pet-portrait { font-size: 66rpx; line-height: 1.5; }
.pet-name { font-size: 26rpx; font-weight: 900; }
.pet-caption { font-size: 20rpx; color: #919579; margin: 8rpx 0 16rpx; flex: 1; }
.pet-state { display: block; width: 100%; padding-top: 12rpx; border-top: 2rpx dashed #d9d9bb; font-size: 21rpx; color: #997334; font-weight: 800; }
.pet-owned .pet-state { color: #708653; }
.pet-vet-note { display: flex; gap: 12rpx; align-items: center; margin: 20rpx 28rpx 34rpx; font-size: 20rpx; color: #83916e; line-height: 1.7; }
.pet-vet-note > view { flex: 1; }
.town-page .pet-vet-note button { font-size: 20rpx; background: transparent; color: #526c40; flex-shrink: 0; }
.pet-sheet { width: 100%; max-height: 82vh; display: flex; flex-direction: column; background: #fffcf3; border: 3rpx solid #4b4935; border-radius: 24rpx; text-align: center; box-shadow: 0 8rpx 0 #344330; overflow: hidden; }
.pet-sheet-body { flex: 1; min-height: 0; overflow: hidden; }
.pet-sheet-body .detail-title, .pet-sheet-body .detail-description { margin: 12rpx 28rpx; }
.pet-sheet-body .detail-memory { margin: 24rpx 28rpx; line-height: 1.8; }
.pet-sheet-portrait { display: block; font-size: 108rpx; line-height: 1.6; padding-top: 22rpx; }
.pet-sheet-actions { padding: 20rpx 28rpx; border-top: 2rpx solid #ece8d6; flex-shrink: 0; }
.town-page .life-dismiss { display: block; width: 100%; padding: 18rpx; background: transparent; color: #7e886b; font-size: 24rpx; line-height: 1.5; }
.life-feedback .detail-memory { line-height: 1.9; }
.life-retry { display: flex; justify-content: space-between; align-items: center; margin: 24rpx; font-size: 23rpx; color: #7c8265; }
.town-page .life-retry button { font-size: 22rpx; padding: 10rpx 20rpx; background: #fffcf1; color: #526c40; border-radius: 10rpx; }
.town-page .life-alert { display: flex; align-items: center; gap: 12rpx; width: calc(100% - 48rpx); margin: 0 24rpx 20rpx; padding: 14rpx 20rpx; border: 2rpx solid #d6c18c; border-radius: 12rpx; background: #fcf2d8; color: #77623b; font-size: 23rpx; line-height: 1.6; text-align: left; }
.life-alert text:nth-child(2) { flex: 1; min-width: 0; }
.life-alert text:last-child { font-size: 20rpx; flex-shrink: 0; }
@media (prefers-reduced-motion: reduce) { .life-walker, .life-roaming-pet, .plot-pets text, .plot-event { animation: none; } }
