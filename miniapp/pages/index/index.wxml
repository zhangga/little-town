<import src="../../templates/voxel.wxml" />
<import src="../../templates/resident.wxml" />
<view class="town-page {{sceneActive ? 'scene-active' : 'scene-paused'}}">
  <view class="town-topbar">
    <view class="town-resource"><view class="town-resource-art"><template is="voxel" data="{{sprite: brickSprite}}" /></view><text class="town-resource-num">{{town.bricks}}</text><text>砖块</text></view>
    <view class="town-resource"><view class="town-resource-art"><template is="voxel" data="{{sprite: coinSprite}}" /></view><text class="town-resource-num">{{town.coins}}</text><text>金币</text></view>
    <view class="town-count">{{buildings.length}} 座建筑</view>
  </view>
  <view wx:if="{{loading}}" class="loading"><view class="town-loading-art"><template is="voxel" data="{{sprite: flagSprite}}" /></view><text>正在打开小镇大门…</text></view>
  <view wx:elif="{{failed}}" class="panel empty"><text>小镇暂时没连上，再试一次吧。</text><button class="btn btn-sun" bindtap="loadTown">重新加载</button></view>
  <scroll-view wx:else class="town-scroll" scroll-y scroll-into-view="{{townAnchor}}" scroll-with-animation>
    <view wx:if="{{growth}}" class="town-welcome"><view class="welcome-character"><template is="resident-art" data="{{art: growth.characterArt}}" /></view><view class="welcome-copy"><view class="welcome-name">你好，{{growth.resident.name}}</view><text>Lv.{{growth.resident.level}} · {{growth.resident.title}}</text><view class="welcome-meter"><view style="width: {{growth.xpPercent}}%;" /></view></view><button bindtap="onGoResident">装扮角色 ›</button></view>
    <view wx:else class="town-intro"><view class="town-title">我的方块小镇</view><button wx:if="{{growthFailed}}" class="growth-retry" bindtap="loadTown">角色暂未连上 · 点此重试</button></view>
    <view wx:if="{{growth}}" class="town-task"><view><view class="task-title">{{growth.daily.done ? '今日任务完成啦！' : '今天的小目标'}}<text>{{growth.daily.completed}} / {{growth.daily.goal}} 词</text></view><text class="task-caption">{{growth.daily.done ? '小目标已完成，还可以继续学或自由复习。' : '学新词或复习旧词，让小镇长一起成长。'}}</text></view><button bindtap="onDailyTask">{{growth.daily.done ? '继续学习' : '开始学习'}} →</button></view>
    <view class="life-weather"><text>{{scene.icon}}</text><view><view>{{scene.label}}</view><text>{{scene.description}}</text></view><text class="life-weather-note">慢慢生活</text></view>
    <button wx:if="{{life.event}}" class="life-alert" bindtap="onGoLife"><text>{{life.event.icon}}</text><text>{{life.event.title}}</text><text>去看看 ›</text></button>
    <view class="town-land {{scene.evening ? 'town-evening' : ''}}">
      <view class="land-meadow" aria-hidden="true"><image wx:for="{{meadowTiles}}" wx:key="id" class="land-meadow-tile" src="/images/town/meadow-grass.jpg" mode="scaleToFill" /></view>
      <view class="land-trees"><template is="voxel" data="{{sprite: treeSprite}}" /></view>
      <view class="town-plots">
        <button wx:if="{{growth}}" class="town-plot occupied home-plot" bindtap="onGoResident" aria-label="进入小镇长的家"><view class="plot-art"><template is="resident-art" data="{{art: growth.homeArt}}" /></view><view class="plot-resident"><template is="resident-art" data="{{art: growth.characterArt}}" /></view><view wx:if="{{growth.gardenArt}}" class="plot-garden"><template is="resident-art" data="{{art: growth.gardenArt}}" /></view><view wx:if="{{life.companions.length}}" class="plot-pets {{life.petResting ? 'pet-resting' : ''}}"><text wx:for="{{life.companions}}" wx:for-item="pet" wx:key="id">{{pet.icon}}</text></view><view wx:if="{{life.event.kind === 'resident_sick'}}" class="plot-event">🩺</view><view class="plot-label">我的家 · Lv.{{growth.home.level}}</view></button>
        <button wx:for="{{plots}}" wx:key="id" class="town-plot {{item.occupied ? 'occupied' : 'vacant'}} {{item.isNew ? 'new-building' : ''}}" style="animation-delay: {{item.delay || 0}}ms;" data-index="{{index}}" bindtap="onPlotTap" aria-label="{{item.occupied ? '查看' + item.name : '空地，去建造'}}">
          <view wx:if="{{item.isNew}}" class="new-flag">新落成！</view>
          <view wx:if="{{life.event && life.event.building === item.name}}" class="plot-event">{{life.event.icon}}</view>
          <view wx:if="{{item.occupied}}" class="plot-art"><template is="voxel" data="{{sprite: item.sprite}}" /></view>
          <view wx:else class="plot-art vacant-ground {{item.next ? 'vacant-next' : ''}}" aria-hidden="true"><view class="build-area" /><view class="build-marker">＋</view></view>
          <view wx:if="{{item.occupied}}" class="plot-label">{{item.name === '宠物医院' ? '🐾 ' : ''}}{{item.name}}</view>
          <view wx:elif="{{item.next}}" class="plot-invite">建造新建筑</view>
          <view wx:else class="plot-empty-label">空地 · 可建造</view>
        </button>
      </view>
      <view class="life-lane" aria-hidden="true"><view wx:for="{{scene.walkers}}" wx:key="index" class="life-walker life-walker-{{index}}"><template is="resident-art" data="{{art: item}}" /></view><view wx:if="{{life.companions.length && !life.petResting}}" class="life-roaming-pet">{{life.companions[0].icon}}</view></view>
      <view class="town-sign"><text>黄色 ＋ 是可建造的空地，点一点添座新建筑</text></view>
    </view>
    <view wx:if="{{lifeFailed}}" class="life-retry"><text>小镇生活暂时没连上</text><button bindtap="loadTown" disabled="{{refreshing || lifeBusy}}">重新看看</button></view>
    <block wx:if="{{life}}">
      <view id="town-life-panel" class="life-section-heading"><view>小镇正在发生<text class="life-dot" /></view><text>生活手账</text></view>
      <view wx:if="{{life.event}}" class="life-event {{life.event.cost ? 'life-event-help' : ''}}">
        <view class="life-event-top"><text class="life-event-icon">{{life.event.icon}}</text><view><text class="life-kicker">{{life.event.cost ? '邻里互助' : '日常小事'}} · {{life.event.building || '我的小院'}}</text><view class="life-event-title">{{life.event.title}}</view></view><text class="life-price">{{life.event.cost ? '1 金币' : '免费'}}</text></view>
        <view class="life-event-description">{{life.event.description}}</view>
        <button class="life-action" disabled="{{lifeBusy || refreshing}}" loading="{{lifeBusy}}" bindtap="onResolveLife">{{lifeBusy ? '正在安排…' : life.event.affordable ? life.event.action + (life.event.cost ? ' · 1 金币' : ' · 免费') : '还差 1 金币 · 去学习'}} →</button>
        <text wx:if="{{life.event.cost}}" class="life-fineprint">小镇内模拟呼叫，每次只花 1 金币</text>
      </view>
      <view wx:else class="life-quiet"><text>🍃</text><view><view>小镇这会儿很悠闲</view><text>{{life.unlocked_count ? '大家各忙各的，过些时候回来看看新故事。' : '添一座建筑，或请一位宠物伙伴搬来，日子就会热闹起来。'}}</text></view></view>
      <view class="life-rule-note">拥有后才解锁对应事情 · 每次一件，慢慢来</view>
      <view wx:if="{{life.recent.length}}" class="life-memory"><text>{{life.recent[0].icon}} 手账里的小事</text><view>{{life.recent[0].outcome}}</view></view>
      <view class="life-section-heading"><view>毛茸茸的邻居</view><text>买一次，一直陪伴</text></view>
      <view class="pet-grid">
        <button wx:for="{{life.pets}}" wx:key="id" class="pet-card {{item.owned ? 'pet-owned' : ''}}" data-id="{{item.id}}" bindtap="onSelectPet" disabled="{{lifeBusy || refreshing || item.owned}}" aria-label="{{item.name + (item.owned ? '，已入住' : '，查看购买，' + item.price + '金币')}}"><text class="pet-portrait">{{item.icon}}</text><view class="pet-name">{{item.name}}</view><text class="pet-caption">{{item.owned ? life.petResting ? '小伙伴在家休息，等医生来' : '正在家门口等你' : item.description}}</text><text class="pet-state">{{item.owned ? '✓ 已入住' : item.price + ' 金币 · 看看它'}}</text></button>
      </view>
      <view class="pet-vet-note"><text>🐾</text><view>{{life.hasVet ? '宠物医院已开门。拥有宠物后，才会出现宠物不舒服的小故事。' : '宠物医院和宠物都拥有后，才会出现宠物生病；看医生只需 1 金币。'}}</view><button wx:if="{{!life.hasVet}}" bindtap="onGoBuild">去建造 ›</button></view>
    </block>
    <view wx:if="{{!buildings.length}}" class="town-first-plan"><view><text class="first-plan-title">第一座建筑，等你动工</text><text class="first-plan-caption">去工坊挑一张喜欢的图纸，看看需要多少砖</text></view><button bindtap="onGoBuild">去看看 →</button></view>
  </scroll-view>
  <view wx:if="{{!loading && !failed}}" class="town-dock"><button class="town-learn" bindtap="onGoLearn">学单词 · 攒砖块</button><button class="town-build" bindtap="onGoBuild">＋ 建造新建筑</button></view>
  <view wx:if="{{selected}}" class="town-mask" bindtap="onCloseDetail" catchtouchmove="onNoop">
    <view class="town-detail" catchtap="onNoop"><view class="detail-art"><template is="voxel" data="{{sprite: selected.sprite}}" /></view><view class="detail-title">{{selected.name}}</view><text class="detail-date">{{selected.builtDate ? selected.builtDate + ' 落成' : '由你亲手建成'}}</text><text class="detail-description">{{selected.description}}</text><view wx:if="{{selected.lifeHint}}" class="detail-memory">{{selected.lifeHint}}</view><view class="detail-memory">{{selected.word_count > 0 ? selected.word_count + ' 个单词在这里被记住' : '一砖一瓦，都是你的学习成果。'}}</view><button bindtap="onCloseDetail">继续逛小镇</button></view>
  </view>
  <view wx:if="{{selectedPet}}" class="town-mask" bindtap="onClosePet" catchtouchmove="onNoop"><view class="pet-sheet" catchtap="onNoop"><scroll-view class="pet-sheet-body" scroll-y><text class="pet-sheet-portrait">{{selectedPet.icon}}</text><view class="detail-title">邀请{{selectedPet.name}}入住</view><text class="detail-description">{{selectedPet.description}}</text><view class="detail-memory"><view>{{selectedPet.price}} 金币 · 永久拥有</view><view>{{life.hasVet ? '宠物医院也准备好啦，生病时看医生只需 1 金币。' : '还没有宠物医院时，小伙伴不会生病。'}}</view></view></scroll-view><view class="pet-sheet-actions"><button class="life-action" disabled="{{lifeBusy || refreshing}}" loading="{{lifeBusy}}" bindtap="onBuyPet">{{lifeBusy ? '正在准备小窝…' : selectedPet.affordable ? '用 ' + selectedPet.price + ' 金币 · 邀请入住' : '还差 ' + selectedPet.missing + ' 金币 · 去学习'}}</button><button class="life-dismiss" disabled="{{lifeBusy}}" bindtap="onClosePet">再想一想</button></view></view></view>
  <view wx:if="{{lifeFeedback}}" class="town-mask" bindtap="onCloseFeedback" catchtouchmove="onNoop"><view class="town-detail life-feedback" catchtap="onNoop"><text class="pet-sheet-portrait">{{lifeFeedback.icon}}</text><view class="detail-title">{{lifeFeedback.title}}</view><view class="detail-memory">{{lifeFeedback.outcome}}</view><button bindtap="onCloseFeedback">继续逛小镇</button></view></view>
</view>
