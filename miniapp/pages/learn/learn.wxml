<template name="audio-controls">
  <view class="audio-controls">
    <button class="audio-button {{audioState === 'playing' ? 'audio-playing' : ''}}" bindtap="onPlayAudio" disabled="{{!word.audio}}" aria-label="播放单词发音">
      <text class="audio-symbol">🔊</text>
      <text>{{audioState === 'loading' ? '加载中…' : (audioState === 'playing' ? '正在读…' : '听发音')}}</text>
    </button>
    <button class="audio-button audio-slow" bindtap="onPlayAudio" data-slow="{{true}}" disabled="{{!word.audio}}">慢速听</button>
  </view>
  <text wx:if="{{audioState === 'error'}}" class="audio-note">暂时没播放出来，点一下重听，也可以继续练习</text>
  <text wx:elif="{{!word.audio}}" class="audio-note">这个词暂时没有读音，先练认词和拼写吧</text>
</template>

<view class="learn-page {{answered && (phase === 'practice' || phase === 'review') ? 'has-answer' : ''}}">
  <view wx:if="{{loading}}" class="loading">
    <text class="loading-emoji">📚</text>
    <text class="loading-text">正在准备今天的单词…</text>
  </view>
  <view wx:elif="{{failed}}" class="panel">
    <view class="empty">
      <text class="empty-emoji">📡</text>
      <text class="empty-text">没能拿到今天的单词，检查网络后再试一次。</text>
      <button class="btn btn-primary" bindtap="onRetry">重新加载</button>
    </view>
  </view>

  <view wx:elif="{{phase === 'ready'}}" class="ready">
    <view class="eyebrow">LITTLE TOWN · 单词探险</view>
    <view class="welcome-row">
      <view>
        <view class="welcome-title">{{freePractice ? '老朋友，再练一练' : goalDone ? '继续探索新单词！' : '今天，换个玩法！'}}</view>
        <view class="welcome-sub">{{words.length}} 个单词 · {{freePractice ? '自由复习' : newCount + ' 个新朋友'}}</view>
      </view>
      <text class="welcome-icon">🎒</text>
    </view>
    <view class="study-note">{{freePractice ? (practiceRewards.remaining_rounds > 0 ? '完成本轮题目和配对，奖励 ' + practiceRewards.bricks_per_round + ' 块砖、' + practiceRewards.coins_per_round + ' 金币；今天还可奖励 ' + practiceRewards.remaining_rounds + ' 轮。' : '今天的自由复习奖励已领满，还可以继续练习；明天再来收获奖励。') : goalDone ? '今日目标已完成，还可以继续学。成长和奖励按每日规则发放，学习不限轮数。' : '每日 ' + dailyGoal + ' 词是小目标，完成后仍然可以继续学习。'}}</view>
    <view class="route-card block">
      <view class="route-title">一颗单词，记住好几面</view>
      <view class="route-stops">
        <view><text class="route-icon">🃏</text><text>认一认</text></view>
        <text class="route-arrow">→</text>
        <view><text class="route-icon">🎧</text><text>听与拼</text></view>
        <text class="route-arrow">→</text>
        <view><text class="route-icon">🤝</text><text>配成对</text></view>
      </view>
      <text class="route-note">看图 · 选词义 · 听音 · 拼写 · 例句填空</text>
    </view>
    <view class="section-label">选一条今天的探险路线</view>
    <button class="mode-card {{mode === 'mixed' ? 'mode-selected' : ''}}" bindtap="onMode" data-mode="mixed">
      <text class="mode-icon">🌈</text>
      <view class="mode-copy"><view class="mode-title">综合闯关 <text class="recommended">推荐</text></view><view class="mode-sub">先认新词，再轮换不同题型</view></view>
      <text class="mode-check">{{mode === 'mixed' ? '✓' : ''}}</text>
    </button>
    <view class="mode-row">
      <button class="mode-card mode-small {{mode === 'listen' ? 'mode-selected' : ''}}" bindtap="onMode" data-mode="listen" disabled="{{!audioCount || !listening}}">
        <text class="mode-icon">🎧</text><view class="mode-title">听力小站</view><view class="mode-sub">用耳朵认单词</view>
      </button>
      <button class="mode-card mode-small {{mode === 'spell' ? 'mode-selected' : ''}}" bindtap="onMode" data-mode="spell">
        <text class="mode-icon">🧩</text><view class="mode-title">拼写工坊</view><view class="mode-sub">用字母搭单词</view>
      </button>
    </view>
    <view class="sound-setting">
      <view><view class="setting-title">加入听力和自动朗读</view><text class="setting-sub">不方便出声时可以关掉</text></view>
      <switch checked="{{listening}}" bindchange="onToggleListening" color="#4E7A2E" aria-label="加入听力和自动朗读" />
    </view>
    <text wx:if="{{audioCount < words.length}}" class="audio-note">有读音的 {{audioCount}} 个词可练听力，其余练认词。</text>
    <button class="btn btn-primary btn-block start-button" bindtap="onStart">{{freePractice ? '开始自由复习' : '开始探险'}} →</button>
  </view>

  <block wx:elif="{{question}}">
    <view class="progress-row">
      <view class="progress-track"><view class="progress-fill" style="width: {{phase === 'review' ? 100 : (index / words.length) * 100}}%;"></view></view>
      <text class="progress-count">{{phase === 'review' ? '巩固 ' + (reviewIndex + 1) + '/' + reviewCount : (index + 1) + ' / ' + words.length}}</text>
    </view>
    <view class="reward-summary" aria-role="status">
      <view class="reward-heading"><text>{{rewardHeader.title}}</text><text class="reward-progress">{{rewardHeader.progress}}</text></view>
      <view class="earned-row">
        <view class="chip"><text>🧱</text><text>{{rewardHeader.bricks}}</text></view>
        <view class="chip"><image class="coin-icon" src="/images/town/gold-coin.png" mode="aspectFit" aria-hidden="true" /><text>{{rewardHeader.coins}}</text></view>
        <text class="stage-tag">{{phase === 'card' ? '新词见面卡' : (phase === 'review' ? '错词再练一次' : question.title)}}</text>
      </view>
      <text class="reward-note">{{rewardHeader.note}}</text>
    </view>

    <view wx:if="{{phase === 'card'}}" class="word-card block">
      <text class="card-kicker">HELLO, NEW FRIEND!</text>
      <text class="card-emoji">{{question.word.emoji}}</text>
      <text class="card-word">{{question.word.word}}</text>
      <template is="audio-controls" data="{{word: question.word, audioState: audioState}}" />
      <button wx:if="{{!flipped}}" class="flip-button" bindtap="onFlip">想一想，它是什么意思？<text>点这里翻开卡片 ↗</text></button>
      <view wx:else class="card-back">
        <text class="card-meaning">{{question.word.translation}}</text>
        <text wx:if="{{question.word.fullSentence}}" class="example">{{question.word.fullSentence}}</text>
        <text wx:if="{{question.word.sentenceMeaning}}" class="example-meaning">{{question.word.sentenceMeaning}}</text>
      </view>
    </view>
    <button wx:if="{{phase === 'card'}}" class="btn btn-primary btn-block next-button" bindtap="onCardContinue" disabled="{{!flipped}}">认识了，试着用一用 →</button>

    <block wx:else>
      <view class="prompt block">
        <text class="question-kicker">{{question.icon}} {{question.title}}</text>
        <block wx:if="{{question.type === 'listen'}}">
          <view class="listen-hero {{audioState === 'playing' ? 'listening' : ''}}">
            <view class="sound-bar"></view><view class="sound-bar"></view><view class="sound-bar"></view><view class="sound-bar"></view><view class="sound-bar"></view>
          </view>
          <text class="listen-title">{{heardAudio ? '听到了吗？选一选' : '神秘单词藏在声音里'}}</text>
        </block>
        <text wx:elif="{{question.type === 'pic'}}" class="prompt-emoji">{{question.word.emoji}}</text>
        <text wx:elif="{{question.type === 'meaning'}}" class="prompt-word">{{question.word.word}}</text>
        <view wx:elif="{{question.type === 'cloze'}}" class="sentence-wrap">
          <text class="sentence">{{question.sentenceBefore}}<text class="sentence-blank">{{answered ? question.word.word : '____'}}</text>{{question.sentenceAfter}}</text>
          <text class="sentence-meaning">{{question.word.sentenceMeaning}}</text>
        </view>
        <block wx:else>
          <text wx:if="{{question.type === 'spell'}}" class="spell-emoji">{{question.word.emoji}}</text>
          <text class="prompt-translation">{{question.word.translation}}</text>
        </block>
        <text class="prompt-hint">{{question.hint}}</text>
        <template wx:if="{{!answered && (question.type === 'listen' || question.type === 'meaning' || question.type === 'spell')}}" is="audio-controls" data="{{word: question.word, audioState: audioState}}" />
        <button wx:if="{{question.type === 'listen' && !answered}}" class="text-button" bindtap="onSkipListening">现在不方便听，换一道认词题</button>
      </view>

      <view wx:if="{{question.type === 'spell'}}" class="spelling-area">
        <view class="letter-slots">
          <button wx:for="{{question.slots}}" wx:key="key" class="letter-slot {{item.fixed ? 'slot-fixed' : ''}} {{answered ? (isCorrect ? 'slot-correct' : 'slot-wrong') : ''}}" data-index="{{index}}" bindtap="onRemoveLetter" disabled="{{answered || item.fixed}}" aria-label="{{item.letter ? '移除字母 ' + item.letter : '待填写字母'}}">{{item.letter || '·'}}</button>
        </view>
        <text class="spelling-help">点上面的字母可以撤回</text>
        <view class="letter-bank">
          <button wx:for="{{question.tiles}}" wx:key="key" class="letter-tile {{item.used ? 'tile-used' : ''}}" data-index="{{index}}" bindtap="onTile" disabled="{{answered || item.used}}">{{item.letter}}</button>
        </view>
        <button wx:if="{{!answered}}" class="text-button" bindtap="onClearSpelling">重新拼</button>
        <button wx:if="{{!answered}}" class="btn btn-primary btn-block" bindtap="onCheckSpelling" disabled="{{!spellReady}}">拼好了，检查一下</button>
      </view>
      <view wx:else class="options">
        <button wx:for="{{question.options}}" wx:key="key" class="option {{answered && item.correct ? 'option-correct' : ''}} {{answered && !item.correct && picked === index ? 'option-wrong' : ''}} {{answered && !item.correct && picked !== index ? 'option-dim' : ''}}" data-index="{{index}}" bindtap="onPick" disabled="{{answered || (question.type === 'listen' && !heardAudio)}}">
          <text class="option-letter">{{index === 0 ? 'A' : (index === 1 ? 'B' : (index === 2 ? 'C' : 'D'))}}</text>
          <text class="option-label">{{item.label}}</text>
          <text wx:if="{{answered && item.correct}}" class="option-mark">✓</text>
          <text wx:elif="{{answered && picked === index}}" class="option-mark">✕</text>
        </button>
      </view>

      <view wx:if="{{answered}}" class="answer-dock {{isCorrect ? 'verdict-ok' : 'verdict-no'}}">
        <view class="answer-summary">
          <view class="answer-copy">
            <text class="verdict-title">{{isCorrect ? '✓ 答对了！' : '再认识它一次'}}</text>
            <text class="answer-word">{{question.word.word}} <text class="answer-meaning">{{question.word.translation}}</text></text>
          </view>
          <view wx:if="{{question.word.audio}}" class="answer-audio">
            <button class="audio-button" bindtap="onPlayAudio" aria-label="重听单词发音">🔊</button>
            <button class="audio-button audio-slow" bindtap="onPlayAudio" data-slow="{{true}}">慢速</button>
          </view>
        </view>
        <text wx:if="{{phase === 'review'}}" class="verdict-sub">{{isCorrect ? '比刚才更熟悉了！' : '再听一遍，下次继续练'}}</text>
        <text wx:elif="{{saving}}" class="verdict-sub">正在把学习成果存进小镇…</text>
        <text wx:elif="{{saveError}}" class="verdict-sub">网络不稳，这题的奖励还没确认，可以手动继续。</text>
        <text wx:elif="{{freePractice}}" class="verdict-sub">{{practiceRewards.remaining_rounds > 0 ? '本题已保存，完成整轮后一起领取奖励。' : '记得更牢了！今天的复习奖励已领满，明天再来收获。'}}</text>
        <text wx:elif="{{lastReward.bricks || lastReward.coins}}" class="verdict-sub">本题收获：砖块 +{{lastReward.bricks}} · 金币 +{{lastReward.coins}}</text>
        <text wx:else class="verdict-sub">{{isCorrect ? '这个词今天已经领过奖励，继续巩固也很棒' : '等会儿会换个方式再练这个词'}}</text>
        <text wx:if="{{lastXP > 0}}" class="verdict-sub">小镇长成长 +{{lastXP}}</text>
        <text class="advance-note">{{saving ? '保存完成后自动继续' : (saveError ? '本题已停留，请查看网络提示' : (autoAdvancePaused ? '已暂停跳转，准备好了再继续' : (isCorrect ? '稍后自动进入下一题' : '看清答案后自动继续')))}}</text>
        <view class="answer-actions">
          <button class="pause-advance" bindtap="onToggleAutoAdvance" disabled="{{saving || saveError}}">{{autoAdvancePaused ? '恢复自动' : '停留看看'}}</button>
          <button class="btn btn-primary next-answer" bindtap="onNext" disabled="{{saving}}">{{saving ? '保存中…' : '继续探险 →'}}</button>
        </view>
      </view>
    </block>
  </block>

  <view wx:elif="{{phase === 'match'}}" class="match-page">
    <view class="eyebrow">最后一站 · 词义配对</view>
    <view class="welcome-title">帮单词找到朋友</view>
    <view class="match-progress">{{pairCount}} / {{pairs.left.length}} 对 <text wx:if="{{pairBatches > 1}}">· 第 {{pairBatch}} 组</text></view>
    <view class="match-columns">
      <view class="match-column">
        <text class="column-heading">英文</text>
        <button wx:for="{{pairs.left}}" wx:key="key" class="pair-button {{item.matched ? 'pair-matched' : ''}} {{pairLeft === index ? (matchWrong ? 'pair-wrong' : 'pair-selected') : ''}}" data-side="left" data-index="{{index}}" bindtap="onMatchPick" disabled="{{item.matched || matchWrong}}">{{item.label}}<text wx:if="{{item.matched}}"> ✓</text></button>
      </view>
      <view class="match-column">
        <text class="column-heading">中文</text>
        <button wx:for="{{pairs.right}}" wx:key="key" class="pair-button {{item.matched ? 'pair-matched' : ''}} {{pairRight === index ? (matchWrong ? 'pair-wrong' : 'pair-selected') : ''}}" data-side="right" data-index="{{index}}" bindtap="onMatchPick" disabled="{{item.matched || matchWrong}}">{{item.label}}<text wx:if="{{item.matched}}"> ✓</text></button>
      </view>
    </view>
    <view class="match-message {{matchWrong ? 'match-error' : ''}}" aria-role="status">{{matchMessage}}</view>
    <button class="btn btn-primary btn-block" bindtap="onMatchNext" disabled="{{!matchDone}}">{{pairBatch < pairBatches ? '下一组' : '收好今天的成果 →'}}</button>
  </view>

  <view wx:else class="done-wrap">
    <view class="done-card block">
      <text class="done-emoji">{{words.length ? '🎉' : '🌱'}}</text>
      <text class="done-title">{{words.length ? (freePractice ? '这一轮复习完成！' : '这一轮探险完成！') : '当前还没有可练的单词'}}</text>
      <text class="done-note">{{words.length ? '听过、想过、拼过，还可以继续下一轮' : '不是达到学习上限。请在“我的”核对年级，或请家长补充单词。'}}</text>
      <view wx:if="{{words.length}}" class="done-stats">
        <view class="done-stat"><text class="done-num">{{stats.right}}</text><text class="done-label">首次答对</text></view>
        <view class="done-stat"><text class="done-num">{{earned.bricks}}</text><text class="done-label">收获砖块</text></view>
        <view class="done-stat"><text class="done-num">{{earned.coins}}</text><text class="done-label">收获金币</text></view>
      </view>
      <text wx:if="{{recovered}}" class="audio-note">巩固答对 {{recovered}} 个单词</text>
      <view wx:if="{{freePractice}}" class="bonus">
        <text class="bonus-title">{{practiceSettling ? '正在收好本轮奖励…' : practiceSettlementError ? '本轮奖励尚未确认' : capped ? '今日自由复习奖励已领满' : '本轮复习奖励已到账！'}}</text>
        <text class="bonus-sub">{{practiceSettlementError ? practiceError : practiceSettled ? '今天还可奖励 ' + practiceRewards.remaining_rounds + ' 轮，自由复习不改变复习计划和成长。' : '请稍等，收获会保存到你的小镇。'}}</text>
        <button wx:if="{{practiceSettlementError}}" class="btn btn-primary btn-block" bindtap="onRetryPracticeReward" disabled="{{practiceSettling}}">重新确认奖励</button>
      </view>
      <view wx:if="{{bonus.granted}}" class="bonus"><text class="bonus-title">完成奖励 🧱 +{{bonus.bricks}}</text><text class="bonus-sub">已包含在本轮收获中</text></view>
      <view wx:if="{{earnedXP > 0}}" class="bonus"><text class="bonus-title">小镇长成长 +{{earnedXP}}</text><text class="bonus-sub">回小镇看看你的新进步</text></view>
      <text wx:if="{{unsaved}}" class="audio-note">有 {{unsaved}} 题的保存结果未确认，回小镇时可查看实际收获。</text>
      <button wx:if="{{words.length}}" class="btn btn-primary btn-block" bindtap="onRetry" disabled="{{practiceSettling}}">{{freePractice ? '再练一组' : '继续学习下一轮'}} →</button>
      <button wx:else class="btn btn-primary btn-block" bindtap="onGoProfile">查看年级和词库</button>
      <button class="btn btn-block" bindtap="onBackToTown">回小镇，看看新成果</button>
      <button wx:if="{{!words.length}}" class="btn btn-block" bindtap="onRetry">重新加载单词</button>
    </view>
  </view>
</view>
