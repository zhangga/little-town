/* pages/parent/parent.wxss
   家长端刻意不用积木语言：这里是纸张、表格线和数字。
   目的是让家长一眼看出"这是数据报告"，而不是另一个游戏界面。
*/
.report {
  min-height: 100vh;
  background: #F2F0EA;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 家长验证 ---------- */

.gate {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gate-card {
  width: 100%;
  background: #FFFFFF;
  border: 2rpx solid #D5D0C4;
  border-radius: 12rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.gate-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23201B;
}

.gate-sub {
  font-size: 25rpx;
  color: #7C766A;
  text-align: center;
  line-height: 1.5;
}

.gate-question {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0 8rpx;
}

.gate-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #23201B;
  font-variant-numeric: tabular-nums;
}

.gate-input {
  width: 180rpx;
  border-bottom: 3rpx solid #23201B;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  color: #23201B;
  padding: 8rpx 0;
}

.gate-placeholder {
  color: #B8B2A6;
}

.gate-error {
  font-size: 24rpx;
  color: #A8391F;
}

.gate-btn {
  width: 100%;
  margin-top: 24rpx;
  background: #23201B;
  color: #FFFFFF;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx;
}

.gate-btn::after {
  border: none;
}

.gate-btn[disabled] {
  background: #B8B2A6;
  color: #FFFFFF;
}

.gate-btn.ghost {
  background: #FFFFFF;
  color: #23201B;
  border: 2rpx solid #D5D0C4;
}

.gate-refresh {
  font-size: 24rpx;
  color: #7C766A;
  text-decoration: underline;
}

/* ---------- 报告头 ---------- */

.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 8rpx 24rpx;
}

.head-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #D5D0C4;
}

.head-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: #FFFFFF;
}

.head-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #23201B;
}

.head-meta {
  font-size: 24rpx;
  color: #7C766A;
}

/* ---------- 卡片 ---------- */

.report-card {
  background: #FFFFFF;
  border: 2rpx solid #D5D0C4;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.report-label {
  font-size: 24rpx;
  color: #7C766A;
  display: block;
}

.report-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.report-note {
  font-size: 22rpx;
  color: #A8A296;
}

.report-loading {
  padding: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7C766A;
}

.report-empty {
  display: block;
  font-size: 26rpx;
  color: #7C766A;
  line-height: 1.6;
}

.report-warn {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #A8391F;
}

/* 大数字 */
.big-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin: 8rpx 0 28rpx;
}

.big-num {
  font-size: 104rpx;
  font-weight: 700;
  line-height: 1;
  color: #23201B;
  font-variant-numeric: tabular-nums;
}

.big-unit {
  font-size: 28rpx;
  color: #7C766A;
}

/* 两栏数据 */
.split {
  display: flex;
  border-top: 2rpx solid #EAE6DC;
  padding-top: 24rpx;
}

.split-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.split-item + .split-item {
  border-left: 2rpx solid #EAE6DC;
  padding-left: 28rpx;
}

.split-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #23201B;
  font-variant-numeric: tabular-nums;
}

.split-label {
  font-size: 23rpx;
  color: #7C766A;
}

/* ---------- 柱状图 ---------- */

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  height: 300rpx;
  padding-top: 16rpx;
}

.chart-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.chart-value {
  font-size: 20rpx;
  color: #7C766A;
  font-variant-numeric: tabular-nums;
}

.chart-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  background: #F7F5F0;
  border-radius: 4rpx 4rpx 0 0;
  overflow: hidden;
}

.chart-bar {
  width: 100%;
  min-height: 6rpx;
  background: #23201B;
  border-radius: 4rpx 4rpx 0 0;
  transition: height 400ms ease;
}

.chart-date {
  font-size: 20rpx;
  color: #A8A296;
}

/* ---------- 今天 ---------- */

.today-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 8rpx;
}

.today-num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  color: #23201B;
  font-variant-numeric: tabular-nums;
}

.today-unit {
  font-size: 26rpx;
  color: #7C766A;
}

/* ---------- 添加单词 ---------- */

.add-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  border: 3rpx dashed #D5D0C4;
  border-radius: 8rpx;
}

.add-trigger-plus {
  font-size: 36rpx;
  color: #7C766A;
  line-height: 1;
}

.add-trigger-text {
  font-size: 27rpx;
  color: #7C766A;
}

.add-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.add-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.add-label {
  font-size: 23rpx;
  color: #7C766A;
}

.add-input {
  border: 2rpx solid #D5D0C4;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #23201B;
}

.add-placeholder {
  color: #B8B2A6;
}

.add-actions {
  display: flex;
  gap: 16rpx;
}

.add-actions .gate-btn {
  margin-top: 0;
}

/* ---------- 页脚 ---------- */

.foot {
  padding: 16rpx 8rpx;
}

.foot-text {
  font-size: 22rpx;
  color: #A8A296;
  line-height: 1.6;
}
