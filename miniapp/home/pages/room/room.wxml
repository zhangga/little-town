<view class="resident-page">
  <view wx:if="{{loading}}" class="loading">正在打开小镇长的家…</view>
  <view wx:elif="{{failed}}" class="resident-empty"><text>小家暂时没连上</text><button class="resident-primary" bindtap="loadResident">重新加载</button></view>
  <block wx:elif="{{state}}">
    <view class="resident-top"><text class="resident-eyebrow">MY LITTLE HOME</text><view class="resident-wallet"><text>{{state.wallet.coins}} 金币</text><text>{{state.wallet.bricks}} 砖块</text></view></view>
    <view class="resident-tabs"><button data-tab="outfit" bindtap="onTab">我的衣橱</button><button data-tab="decoration" bindtap="onTab">庭院装饰</button><button data-tab="home" bindtap="onTab">小屋升级</button><button class="active" aria-label="当前界面：屋内生活">屋内生活</button></view>
    <include src="../../templates/home-room.wxml" />
  </block>
</view>
