page { background: #f7f1e4; color: #4c5441; }
.mall-page { padding: 24rpx 28rpx 48rpx; }
.mall-page button { margin: 0; padding: 0; width: auto; font: inherit; line-height: 1.5; }
.mall-page button::after { border: 0; }
.mall-top { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; color: #8a8a70; }
.mall-wallet { padding: 10rpx 20rpx; color: #8b703d; background: #eee3bd; border-radius: 30rpx; font-weight: 700; }
.mall-hero { position: relative; height: 350rpx; margin-top: 22rpx; border-bottom: 2rpx solid #d8d5be; }
.mall-hero-copy { position: relative; z-index: 1; padding-top: 22rpx; }
.mall-eyebrow { font-size: 15rpx; letter-spacing: 2rpx; color: #929980; }
.mall-title { font-size: 58rpx; font-weight: 900; letter-spacing: 5rpx; margin: 12rpx 0 14rpx; }
.mall-subtitle { font-size: 26rpx; line-height: 1.8; color: #7e856f; display: block; max-width: 260rpx; white-space: pre-line; }
.mall-stamp { display: block; font-size: 19rpx; color: #9b895f; margin-top: 23rpx; }
.mall-building { position: absolute; width: 390rpx; height: 365rpx; right: -27rpx; top: -2rpx; }
.mall-collection { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 0; }
.mall-collection > view { display: flex; flex-direction: column; gap: 5rpx; font-size: 26rpx; font-weight: 700; }
.mall-muted { font-size: 20rpx; font-weight: 400; color: #94967d; }
.mall-collection button { font-size: 23rpx; color: #5a7257; background: #e4e8d4; padding: 13rpx 19rpx; border-radius: 12rpx; }
.mall-categories { display: flex; gap: 8rpx; border-bottom: 2rpx solid #d9d8c6; padding-bottom: 15rpx; }
.mall-categories button { flex: 1; padding: 13rpx 3rpx; color: #858970; border-radius: 10rpx; background: transparent; font-size: 23rpx; }
.mall-categories button.active { background: #526b51; color: #fff9e8; }
.mall-heading { display: flex; justify-content: space-between; margin: 27rpx 0 19rpx; font-size: 21rpx; color: #838b72; }
.mall-heading text:first-child { color: #646f55; }
.mall-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }
.mall-page .furniture-card { width: 100%; position: relative; text-align: left; padding: 0 23rpx 18rpx; border: 2rpx solid #dfdac4; border-radius: 22rpx; background: #fffcf3; overflow: hidden; }
.furniture-stage { height: 234rpx; margin: 0 -23rpx 10rpx; background: #f0f0df; border-bottom: 2rpx solid #e7e6d3; }
.furniture-stage image { width: 100%; height: 100%; }
.furniture-owned { position: absolute; right: 12rpx; top: 12rpx; font-size: 17rpx; color: #638062; background: #fffcf0df; padding: 5rpx 10rpx; border-radius: 8rpx; }
.furniture-name { font-size: 25rpx; font-weight: 800; color: #4e5c43; }
.furniture-verb { font-size: 20rpx; color: #9b9f86; }
.furniture-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; font-size: 24rpx; font-weight: 700; color: #9d814a; }
.furniture-plus { display: flex; align-items: center; justify-content: center; width: 39rpx; height: 39rpx; background: #e7ecd9; color: #65825c; border-radius: 50%; }
.mall-footnote { margin-top: 32rpx; text-align: center; font-size: 20rpx; color: #a1a087; }
.mall-notice { background: #eee4cb; border-radius: 16rpx; margin-top: 20rpx; padding: 20rpx; display: flex; gap: 14rpx; align-items: center; font-size: 25rpx; }
.mall-notice view { flex: 1; }
.mall-notice text { display: block; font-size: 20rpx; color: #9a8d6c; margin-top: 5rpx; }
.mall-notice button { background: transparent; color: #8c7147; font-size: 23rpx; flex-shrink: 0; }
.mall-empty { padding: 80rpx 20rpx; text-align: center; color: #8d947b; }
.mall-empty button { margin: 25rpx auto; padding: 15rpx 30rpx; background: #dfe7cf; color: #546b48; }
.mall-mask { position: fixed; inset: 0; z-index: 200; background: #303e3399; display: flex; align-items: flex-end; }
.mall-sheet { width: 100%; background: #fffcf2; border-radius: 32rpx 32rpx 0 0; max-height: 90vh; display: flex; flex-direction: column; }
.mall-sheet-top { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 28rpx 0; font-size: 22rpx; color: #8d977c; }
.mall-sheet-top button { width: 70rpx; height: 70rpx; background: transparent; font-size: 40rpx; color: #7c8c70; }
.mall-sheet-scroll { min-height: 0; max-height: 57vh; text-align: center; }
.mall-detail-art { width: 340rpx; height: 310rpx; display: block; margin: 0 auto; }
.mall-detail-name { font-size: 37rpx; font-weight: 800; }
.mall-detail-copy { display: block; margin: 16rpx 50rpx; font-size: 25rpx; color: #8a927b; line-height: 1.8; }
.mall-detail-price { color: #a08041; font-size: 29rpx; font-weight: 700; margin: 15rpx 0; }
.mall-missing { display: block; font-size: 23rpx; color: #a28459; margin-bottom: 18rpx; }
.mall-purchased { margin: 20rpx 35rpx; padding: 18rpx; background: #eaf0db; color: #607a50; font-size: 24rpx; border-radius: 12rpx; }
.mall-sheet-actions { padding: 22rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid #e3e3cf; }
.mall-page .mall-primary { background: #566e51; color: #fffae9; width: 100%; padding: 22rpx 15rpx; border-radius: 14rpx; font-size: 27rpx; font-weight: 700; }
.mall-primary[disabled] { opacity: .5; }
.mall-sheet-actions > text { display: block; text-align: center; color: #9aa188; font-size: 19rpx; margin-top: 14rpx; }
