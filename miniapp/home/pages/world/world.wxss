.voxel-page .world-dpad button{width:42px;height:38px;font-size:25px;border-width:1px;border-bottom-width:3px;border-radius:7px}
.voxel-page .dpad-up,.voxel-page .dpad-down{left:45px}.voxel-page .dpad-left,.voxel-page .dpad-right{top:41px}
.voxel-page .dpad-center{left:44px;top:42px;width:44px;height:36px;font-size:9px;letter-spacing:0;color:#7d8768;text-shadow:none}
.voxel-page .world-action-pad{display:flex;flex-wrap:wrap;grid-template-columns:none;width:160px;gap:8px;transform:none}
.voxel-page .world-action-pad button{width:76px;height:55px;font-size:19px;gap:4px;border-width:1px;border-bottom-width:3px;border-radius:8px}
.voxel-page .world-action-pad button text{font-size:13px}.voxel-page .world-action-pad button .action-key{font-size:9px;margin-top:-6px}
.voxel-page .world-held-row{bottom:73px;width:calc(100% - 30px);max-width:430px;font-size:10px;color:#778264;text-shadow:none;gap:8px}
.voxel-page .world-held-row button{font-size:10px;padding:2px 7px}
.voxel-page .world-hotbar{bottom:18px;max-width:430px;width:calc(100% - 28px);gap:5px;padding:5px;border-width:1px;border-bottom-width:3px;border-radius:8px;box-shadow:none}
.voxel-page .hotbar-slot{height:42px;gap:2px}.voxel-page .hotbar-name{font-size:9px}.voxel-page .hotbar-number,.voxel-page .hotbar-count{font-size:8px;top:2px}.voxel-page .hotbar-slot .item-cube{width:18px;height:18px;margin:0;box-shadow:inset -4px -3px #0002,inset 0 3px #fff3}.voxel-page .hotbar-slot image{height:26px;width:28px;margin:0}.voxel-page .hotbar-bag{width:30px;gap:3px;font-size:18px!important}.voxel-page .hotbar-bag text{font-size:9px}
.voxel-page .world-bottom{bottom:4px;left:15px;right:15px;font-size:8px;color:#8d967b;text-shadow:none;letter-spacing:0}.voxel-page .world-bottom button{font-size:8px}
.dimension-aether .world-title,.dimension-aether .world-eyebrow{color:#42543b;text-shadow:none}
@media(max-height:650px){.world-stage{top:107px;bottom:244px}.voxel-page .world-tools{top:70px}.voxel-page .world-location{top:50px}.voxel-page .world-top{top:7px}.voxel-page .world-title{font-size:19px}.voxel-page .world-top-actions button{height:34px}.voxel-page .world-target{bottom:205px}.voxel-page .world-note{bottom:187px}.voxel-page .world-controls{bottom:61px}.voxel-page .world-held-row{display:none}.voxel-page .world-hotbar{bottom:16px;padding:3px}.voxel-page .hotbar-slot{height:32px}.voxel-page .hotbar-slot .item-cube{width:13px;height:13px}.voxel-page .hotbar-slot image{height:19px}.voxel-page .hotbar-name{font-size:8px}}
@media(max-width:340px){.voxel-page .world-dpad{width:120px}.voxel-page .dpad-up,.voxel-page .dpad-down{left:39px}.voxel-page .dpad-center{left:38px}.voxel-page .world-action-pad{width:144px;gap:6px}.voxel-page .world-action-pad button{width:69px}.voxel-page .world-title{font-size:20px}}
@media(max-height:500px) and (min-width:650px){.world-stage{top:85px;bottom:18px;right:300px}.voxel-page .world-target{left:auto;right:15px;width:270px;bottom:214px}.voxel-page .world-note{left:auto;right:15px;width:270px;bottom:191px}.voxel-page .world-controls{left:auto;right:15px;width:270px;bottom:61px}.voxel-page .world-dpad{width:120px}.voxel-page .dpad-up,.voxel-page .dpad-down{left:39px}.voxel-page .dpad-center{left:38px}.voxel-page .world-action-pad{width:144px;gap:6px}.voxel-page .world-action-pad button{width:69px}.voxel-page .world-hotbar{left:auto;right:15px;transform:none;width:270px}.voxel-page .world-tools{right:300px;top:49px}.voxel-page .world-location{left:auto;right:15px;width:270px;top:63px}.voxel-page .world-bottom>text{display:none}}
