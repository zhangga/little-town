page{background:#e8e4d4;overflow:hidden}.home-page{position:relative;width:100%;height:100vh;overflow:hidden;color:#4f563e;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.home-page button{margin:0;padding:0;line-height:1.4;font-size:24rpx;font-weight:500;color:inherit;background:transparent;border-radius:0;box-sizing:border-box}.home-page button::after{border:0}.home-page button[disabled]{opacity:.45}.home-page button:active{opacity:.75}.home-space{display:block;position:absolute;left:0;top:0;width:100%;height:100%;z-index:0}
.home-tabs{position:absolute;top:14rpx;left:24rpx;right:24rpx;height:70rpx;display:flex;align-items:center;justify-content:space-between;z-index:2;border-bottom:1rpx solid #85836c20}.home-tabs button,.home-tabs text{font-size:22rpx;color:#8b8a74;padding:10rpx 8rpx;letter-spacing:1rpx}.home-tabs .active{color:#586547;font-weight:700;border-bottom:3rpx solid #8c9a70}
.room-heading{position:absolute;left:40rpx;top:126rpx;display:flex;flex-direction:column;gap:8rpx;pointer-events:none;z-index:1}.room-kicker{font-size:16rpx;letter-spacing:3rpx;color:#98987e}.room-title{font-size:46rpx;font-weight:700;letter-spacing:4rpx;color:#526348}.room-subtitle{font-size:22rpx;letter-spacing:1rpx;color:#8d9075}.room-view-tools{position:absolute;right:28rpx;top:132rpx;display:flex;flex-direction:column;align-items:flex-end;gap:14rpx;z-index:2}.home-page .room-view-mode{font-size:21rpx;padding:14rpx 18rpx;background:#fbf8e8b8;border:1rpx solid #fff8dfb0;border-radius:16rpx;box-shadow:0 3rpx 12rpx #655f3a08}.room-zoom{display:flex;gap:2rpx;border-radius:12rpx;overflow:hidden;background:#fbf8e8a0}.home-page .room-zoom button{height:54rpx;width:54rpx;font-size:31rpx;color:#85906c}.home-page .room-help-button{width:45rpx;height:45rpx;border-radius:50%;background:#fbf8e890;font-size:24rpx;color:#9a9c82}.room-help{position:absolute;z-index:6;right:28rpx;top:340rpx;padding:26rpx;background:#fffbecf5;box-shadow:0 12rpx 50rpx #4b563f20;border:1rpx solid #dddcc5;border-radius:18rpx}.room-help text{display:block;font-size:22rpx;line-height:1.9;color:#7c8466}
.room-bottom{position:absolute;bottom:calc(26rpx + env(safe-area-inset-bottom));left:36rpx;right:36rpx;z-index:3;pointer-events:none}.room-dock{display:flex;justify-content:space-between;align-items:flex-end;gap:24rpx;pointer-events:none}.room-dock>view,.room-dock>button{pointer-events:auto}.room-message{font-size:21rpx;line-height:1.6;color:#838970;margin:0 120rpx 26rpx 0;max-width:470rpx;text-shadow:0 1rpx 6rpx #fff9df;pointer-events:none;min-height:32rpx}.room-wasd{display:grid;grid-template-columns:repeat(3,66rpx);grid-template-rows:60rpx 60rpx 28rpx;gap:6rpx}.home-page .room-wasd button{width:66rpx;height:60rpx;border:2rpx solid #fffbebba;border-bottom:5rpx solid #bdc0a389;border-radius:14rpx;background:#f6f2dfb0;color:#6f7c56;font-size:25rpx;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-weight:700}.home-page .room-wasd .key-held{background:#8e9d6f;color:#fff5d7;border-bottom-color:#66764d;transform:translateY(3rpx)}.key-w{grid-column:2;grid-row:1}.key-a{grid-column:1;grid-row:2}.key-s{grid-column:2;grid-row:2}.key-d{grid-column:3;grid-row:2}.room-wasd>text{grid-column:1/4;text-align:center;font-size:17rpx;color:#999e81;letter-spacing:2rpx;line-height:28rpx}
.home-page .room-bag-button{display:flex;flex-direction:column;align-items:center;gap:10rpx;width:112rpx;padding:12rpx 5rpx 4rpx;overflow:visible}.room-bag-button>text{font-size:20rpx;color:#847859;letter-spacing:2rpx}.backpack-icon{position:relative;width:72rpx;height:80rpx;filter:drop-shadow(0 8rpx 5rpx #76664430);transition:transform .2s}.bag-open .backpack-icon{transform:translateY(-6rpx) rotate(-6deg)}.backpack-handle{position:absolute;left:22rpx;top:0;width:28rpx;height:22rpx;border:7rpx solid #91633e;border-radius:13rpx 13rpx 0 0;box-sizing:border-box}.backpack-body{position:absolute;top:12rpx;left:3rpx;width:66rpx;height:66rpx;border-radius:20rpx 20rpx 15rpx 15rpx;background:linear-gradient(105deg,#ceaa70,#b48752);border:3rpx solid #99723f;box-shadow:inset -6rpx -3rpx 0 #98743d33,3rpx 4rpx 0 #765b3725}.backpack-flap{position:absolute;top:-2rpx;left:-3rpx;width:66rpx;height:31rpx;border-radius:17rpx 17rpx 13rpx 13rpx;background:#d6b57c;border:3rpx solid #a9814d;border-bottom-width:5rpx}.backpack-flap::after{content:"";position:absolute;top:14rpx;left:27rpx;width:8rpx;height:19rpx;border-radius:2rpx;background:#886237;border:1rpx solid #6d502e}.backpack-pocket{position:absolute;bottom:6rpx;left:12rpx;width:36rpx;height:20rpx;border:2rpx solid #99723e;background:#c69c60;border-radius:4rpx 4rpx 8rpx 8rpx}.backpack-count{position:absolute;right:-16rpx;top:0;background:#76885c;color:#fff4d8;min-width:28rpx;height:28rpx;line-height:28rpx;text-align:center;border-radius:50%;border:3rpx solid #ece8d7;font-size:16rpx;font-weight:700}
.room-backpack,.room-inspector{position:absolute;left:24rpx;right:24rpx;bottom:calc(205rpx + env(safe-area-inset-bottom));z-index:5;background:#faf6e8f5;border:2rpx solid #fffcef;border-radius:24rpx;box-shadow:0 16rpx 45rpx #5d62431a;overflow:hidden}.room-bag-top{display:flex;align-items:center;justify-content:space-between;padding:24rpx 24rpx 10rpx}.room-bag-title{display:block;font-size:27rpx;font-weight:700;letter-spacing:2rpx;color:#64704f}.room-bag-subtitle{display:block;font-size:18rpx;color:#a0a28c;margin-top:7rpx}.home-page .room-bag-top button{width:50rpx;height:50rpx;font-size:34rpx;color:#969c81}.room-bag-scroll{white-space:nowrap;width:100%}.room-bag-items{display:inline-flex;gap:12rpx;padding:4rpx 18rpx 24rpx}.home-page .room-bag-items button{width:151rpx;flex-shrink:0;background:#ecebdb88;border-radius:16rpx;padding:5rpx 8rpx 16rpx}.room-bag-items image{display:block;width:130rpx;height:126rpx;margin:auto}.room-bag-items text{display:block;font-size:19rpx;text-align:center;color:#687750;white-space:normal}.room-bag-items .room-bag-state{font-size:16rpx;color:#a5a48c;margin-top:7rpx}.home-page .room-bag-shop{display:flex;flex-direction:column;align-items:center;justify-content:center;background:transparent;border:2rpx dashed #d4d8c1}.room-bag-shop text:first-child{font-size:50rpx;font-weight:300;margin-bottom:20rpx;color:#a7b18c}
.room-inspector{bottom:calc(160rpx + env(safe-area-inset-bottom));padding:22rpx;box-sizing:border-box}.room-selection{display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:25rpx;font-weight:700}.room-selection text+text{font-size:18rpx;font-weight:400}.room-placement-ok{color:#8a9573}.room-placement-bad{color:#b67b55}.room-angle{display:flex;align-items:center;gap:14rpx;margin:16rpx 0 8rpx}.room-angle slider{flex:1;margin:0 6rpx}.home-page .room-angle button{width:52rpx;height:52rpx;font-size:33rpx;background:#eaecd9;border-radius:12rpx;color:#8c9872}.room-angle>text{font-size:22rpx;color:#7f8b66;width:62rpx;text-align:center}.room-place-actions{display:flex;gap:16rpx;justify-content:flex-end}.home-page .room-place-actions button{padding:14rpx 28rpx;font-size:21rpx;border-radius:12rpx}.home-page .room-store{color:#a19c7d}.home-page .room-place{background:#e0e7cb;color:#687c50}.room-save>text{display:block;font-size:18rpx;color:#9a997e;margin-bottom:16rpx}.room-save>view{display:flex;gap:14rpx}.home-page .room-save button{padding:20rpx 28rpx;border-radius:16rpx;font-size:24rpx}.home-page .room-cancel{color:#8a8b70;background:#f7f4e4a0}.home-page .room-save-button{color:#fff8de;background:#7b8e5d;box-shadow:0 5rpx 0 #62744b}
.room-loading{position:absolute;inset:0;background:#e8e4d4e8;z-index:9;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28rpx;font-size:26rpx;color:#8a9275}.room-loading-house{font-size:85rpx;color:#a0ab83}.home-page .room-loading button{background:#7f8f64;color:#fff6df;padding:16rpx 34rpx;border-radius:12rpx}
.nature-mask{position:absolute;inset:0;z-index:12;background:#334638ad;display:flex;align-items:center;justify-content:center;padding:30rpx}.nature-sheet{width:100%;padding:24rpx;background:#f5f0df;border:8rpx solid #859879;border-radius:26rpx;box-sizing:border-box}.nature-top{display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#8a9779;margin-bottom:20rpx}.home-page .nature-top button{width:60rpx;font-size:38rpx;color:#718666}.nature-screen{background:#344a3b;padding:10rpx;border-radius:12rpx}.nature-screen image{display:block;width:100%;height:310rpx}.nature-name{text-align:center;margin-top:28rpx;font-size:32rpx;font-weight:700;color:#607850}.nature-caption{display:block;text-align:center;color:#919b81;font-size:23rpx;margin:12rpx 0 26rpx;line-height:1.8}.nature-actions{display:flex;gap:18rpx}.home-page .nature-actions button{flex:1;padding:18rpx;background:#dce6cd;color:#657c54;border-radius:12rpx;font-size:24rpx}.home-page .nature-close{color:#8f9b7e;font-size:23rpx;margin:24rpx auto 0;padding:14rpx}
@media(max-height:600px){.room-heading{top:100rpx}.room-title{font-size:36rpx}.room-subtitle{display:none}.room-view-tools{top:105rpx}.room-bottom{bottom:18rpx}.room-message{margin-bottom:12rpx}.room-backpack{bottom:180rpx}.room-inspector{bottom:138rpx}}

.home-page::before{content:"";position:absolute;left:0;top:0;right:0;height:260rpx;background:linear-gradient(#e8e4d4e8,#e8e4d460,transparent);z-index:1;pointer-events:none}.camera-close .room-heading{top:112rpx;gap:5rpx}.camera-close .room-title{font-size:30rpx}.camera-close .room-subtitle{display:none}.camera-close .room-kicker{font-size:13rpx}.camera-close .room-message{color:#626e51;background:#f8f5e5bb;border-radius:10rpx;padding:9rpx 14rpx}

.room-view-pair{display:flex;gap:8rpx}.home-page .room-view-pair button{background:#fbf8e8c9;padding:12rpx 16rpx;border-radius:12rpx;font-size:20rpx}.home-page .room-door-control{font-size:21rpx;color:#796140;background:#f8efdbd9;border:1rpx solid #cdbb9270;padding:12rpx 18rpx;border-radius:12rpx}.room-crosshair{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;pointer-events:none;font:30rpx/1 monospace;color:#fffae2;text-shadow:0 1rpx 3rpx #343d2f;opacity:.7}.camera-first .room-heading{top:108rpx;gap:4rpx}.camera-first .room-title{font-size:28rpx}.camera-first .room-kicker{font-size:14rpx}.camera-first .room-subtitle{font-size:18rpx}.camera-first .room-message{background:#f8f5e5d0;border-radius:10rpx;padding:9rpx 14rpx;color:#626e51}.room-help{top:420rpx}
.home-page .room-jump{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7rpx;flex-shrink:0;width:112rpx;height:94rpx;margin-bottom:36rpx;border:2rpx solid #fffbebba;border-bottom:5rpx solid #a9b58c;border-radius:18rpx;background:#e6ebd5d9;color:#6b7e53}.room-jump text:first-child{font-size:38rpx;line-height:1}.room-jump text+text{font-size:17rpx;white-space:nowrap}.home-page .room-jump.is-jumping{background:#8e9d6f;color:#fff7df;transform:translateY(-5rpx)}.home-page .room-mouse-control{font-size:18rpx;padding:10rpx 14rpx;border-radius:12rpx;background:#fbf8e8c9;color:#758064}.room-help{top:500rpx;max-width:calc(100% - 56rpx);box-sizing:border-box}
