.home-life { margin-top: 24rpx; background: #fffcf1; border: 2rpx solid #d2dac0; border-radius: 24rpx; overflow: hidden; }
.room-heading { padding: 26rpx 24rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.room-heading > view > view { font-size: 28rpx; font-weight: 800; margin-top: 8rpx; }
.room-eyebrow { font-size: 16rpx; color: #9ba58b; letter-spacing: 2rpx; }
.room-day { flex-shrink: 0; font-size: 19rpx; padding: 7rpx 12rpx; border-radius: 12rpx; color: #9b844a; background: #f5edcd; }
.room-scene { position: relative; width: 100%; height: 560rpx; background: #f1f0de; margin-top: 20rpx; overflow: hidden; }
.room-shell { width: 100%; height: 560rpx; position: absolute; inset: 0; }
.resident-page .room-cell { position: absolute; width: 10.9%; height: 42rpx; background: transparent; transform: translate(-50%,-50%); border-radius: 0; clip-path: polygon(50% 0,100% 50%,50% 100%,0 50%); z-index: 1; }
.resident-page .room-cell.cell-valid { background: #c2d89a88; }
.resident-page .room-cell.cell-valid:active { background: #719657aa; }
.resident-page .room-furniture { position: absolute; width: 110rpx; height: 110rpx; background: transparent; overflow: visible; transform: translate(-50%,-84%); }
.room-furniture image { width: 100%; height: 100%; pointer-events: none; }
.resident-page .room-furniture-wide { width: 155rpx; height: 155rpx; }
.room-furniture.furniture-selected { filter: drop-shadow(0 0 5rpx #e1ae36); }
.room-lamp-glow { position: absolute; width: 110rpx; height: 110rpx; border-radius: 50%; top: -10rpx; left: 0; background: radial-gradient(#ffed9f88,transparent 70%); pointer-events: none; }
.room-water { position: absolute; top: -15rpx; left: 32rpx; font-size: 23rpx; animation: room-bob 1s ease-in-out infinite; white-space: nowrap; }
.room-actor { position: absolute; width: 108rpx; height: 108rpx; transform: translate(-50%,-83%); pointer-events: none; transition: left .22s linear,top .22s linear; }
.room-actor-body { height: 100%; width: 100%; transform-origin: 50% 85%; }
.room-actor-shadow { position: absolute; width: 36rpx; height: 13rpx; border-radius: 50%; background: #54573b33; bottom: 15rpx; left: 36rpx; }
.actor-walking .room-actor-body { animation: room-walk .22s ease-in-out infinite alternate; }
.actor-sit .room-actor-body { transform: translateY(7rpx) scaleY(.84); }
.actor-sleep .room-actor-body { transform: rotate(-65deg) translate(-8rpx,7rpx); }
.actor-stretch .room-actor-body { animation: room-stretch 1.8s ease-in-out infinite; }
.room-reaction { position: absolute; top: -12rpx; right: 0; font-size: 23rpx; color: #6c8a70; font-weight: 800; animation: room-bob 1.5s ease-in-out infinite; }
.room-entrance { position: absolute; bottom: 18rpx; width: 100%; text-align: center; color: #a8a084; font-size: 17rpx; letter-spacing: 3rpx; }
.room-message { display: flex; gap: 13rpx; align-items: center; padding: 20rpx 24rpx; min-height: 82rpx; box-sizing: border-box; border-top: 2rpx solid #e2dfc8; background: #f7f5e5; color: #858464; font-size: 23rpx; line-height: 1.6; }
.room-message text:first-child { color: #b29b5a; }
.room-playbar { display: flex; align-items: center; justify-content: space-around; padding: 24rpx 20rpx; gap: 20rpx; }
.room-control { display: grid; grid-template-columns: repeat(3,64rpx); grid-template-rows: repeat(3,57rpx); gap: 5rpx; }
.resident-page .room-control button { width: 64rpx; padding: 0; font-size: 29rpx; background: #e9edd9; border: 2rpx solid #cfd8ba; border-bottom-width: 5rpx; color: #687c52; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; gap: 4rpx; }
.room-control button text { font-size: 18rpx; }
.move-up { grid-column: 2; grid-row: 1; }.move-left { grid-column: 1; grid-row: 2; }.move-right { grid-column: 3; grid-row: 2; }.move-down { grid-column: 2; grid-row: 3; }
.move-center { grid-column: 2; grid-row: 2; display: flex; align-items: center; justify-content: center; color: #b8bd99; font-size: 25rpx; }
.room-play-actions { display: flex; flex-direction: column; gap: 14rpx; flex: 1; max-width: 315rpx; }
.resident-page .room-main { width: 100%; padding: 18rpx 14rpx; border-radius: 12rpx; background: #58734c; color: #fffbe8; font-size: 25rpx; font-weight: 700; }
.resident-page .room-shopping { padding: 12rpx; background: transparent; color: #8c835a; font-size: 23rpx; }
.room-play-actions > text { text-align: center; font-size: 18rpx; color: #a3a68b; }
.room-interact-heading { margin: 0 24rpx; border-top: 2rpx solid #e8e7d5; padding-top: 22rpx; font-size: 24rpx; font-weight: 700; }
.room-interact-heading > text { display: block; font-size: 19rpx; color: #9ba58b; font-weight: 400; margin-top: 4rpx; }
.room-quick-actions { display: flex; flex-wrap: wrap; padding: 14rpx 20rpx 20rpx; gap: 10rpx; }
.resident-page .room-quick-actions button { width: calc(25% - 8rpx); background: #f3f3e5; border-radius: 14rpx; padding: 0 4rpx 14rpx; box-sizing: border-box; }
.room-quick-actions image { width: 100%; height: 100rpx; display: block; }
.room-quick-actions text { font-size: 20rpx; color: #849274; display: block; }
.room-edit-toolbar { display: flex; align-items: center; gap: 12rpx; padding: 20rpx; }
.room-edit-toolbar > text { flex: 1; font-size: 20rpx; color: #a18a54; }
.resident-page .room-edit-toolbar button { width: auto; padding: 12rpx 18rpx; background: #edf0de; color: #6e805e; font-size: 22rpx; border-radius: 10rpx; }
.room-inventory { width: 100%; white-space: nowrap; }
.room-inventory-row { display: inline-flex; gap: 12rpx; padding: 0 20rpx 16rpx; }
.resident-page .room-inventory-row button { flex-shrink: 0; width: 160rpx; padding: 0 8rpx 14rpx; box-sizing: border-box; background: #f1f1e3; border: 2rpx solid #e0e2ca; border-radius: 14rpx; }
.resident-page .room-inventory-row button.inventory-selected { border-color: #8ca070; background: #e9efd7; }
.room-inventory image { width: 130rpx; height: 126rpx; display: block; margin: auto; }
.room-inventory text { display: block; font-size: 20rpx; color: #677c54; }
.room-inventory .inventory-state { font-size: 16rpx; color: #9caa89; margin-top: 5rpx; }
.room-save-actions { display: flex; gap: 14rpx; padding: 12rpx 24rpx; }
.resident-page .room-cancel { width: 170rpx; flex-shrink: 0; color: #869477; background: #edf0df; padding: 18rpx; font-size: 25rpx; border-radius: 12rpx; }
.room-more { margin: 0 auto 16rpx !important; }
.room-unavailable { padding: 35rpx 24rpx; color: #8b967c; font-size: 23rpx; text-align: center; }
.room-unavailable button { margin-top: 20rpx; padding: 16rpx; font-size: 24rpx; }
.resident-page .room-wardrobe-link { margin: 0 24rpx 24rpx; padding: 15rpx; background: #e4ead4; color: #698359; font-size: 24rpx; }
.nature-mask { position: fixed; inset: 0; z-index: 250; background: #26382dd9; display: flex; align-items: center; justify-content: center; padding: 30rpx; }
.nature-sheet { width: 100%; max-height: 88vh; overflow-y: auto; padding: 24rpx; background: #f5f0df; border: 8rpx solid #859879; border-radius: 26rpx; box-sizing: border-box; }
.nature-top { display: flex; justify-content: space-between; align-items: center; font-size: 23rpx; color: #8a9779; margin-bottom: 20rpx; }
.resident-page .nature-top button { width: 60rpx; background: transparent; font-size: 38rpx; color: #718666; }
.nature-screen { background: #344a3b; padding: 10rpx; border-radius: 12rpx; }
.nature-screen image { display: block; width: 100%; height: 310rpx; }
.nature-name { text-align: center; margin-top: 28rpx; font-size: 32rpx; font-weight: 700; color: #607850; }
.nature-caption { display: block; text-align: center; color: #919b81; font-size: 23rpx; margin: 12rpx 0 26rpx; line-height: 1.8; }
.nature-actions { display: flex; gap: 18rpx; }
.resident-page .nature-actions button { flex: 1; padding: 18rpx; background: #dce6cd; color: #657c54; border-radius: 12rpx; font-size: 24rpx; }
.resident-page .nature-close { background: transparent; color: #8f9b7e; font-size: 23rpx; margin: 24rpx auto 0; }
@keyframes room-walk { from { transform: translateY(-3rpx) rotate(-3deg); } to { transform: translateY(1rpx) rotate(3deg); } }
@keyframes room-bob { 50% { transform: translateY(-7rpx); } }
@keyframes room-stretch { 50% { transform: scaleY(1.08) rotate(5deg); } }
@media (prefers-reduced-motion: reduce) { .room-actor { transition: none; }.room-actor-body,.room-water,.room-reaction { animation: none !important; } }
