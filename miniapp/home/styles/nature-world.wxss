.home-page .nature-invitation{position:absolute;left:38rpx;top:300rpx;z-index:3;display:flex;align-items:center;gap:16rpx;padding:18rpx 24rpx;background:#f3f3dfed;border:1rpx solid #ffffffa0;border-radius:18rpx;box-shadow:0 6rpx 24rpx #314c3510;text-align:left;color:#3d634d}.nature-invitation-icon{font:54rpx/1 Georgia,serif;color:#799563}.nature-invitation view>text{display:block;font-size:23rpx;font-weight:600;letter-spacing:1rpx}.nature-invitation view>text+text{font-size:17rpx;font-weight:400;color:#8b997a;margin-top:5rpx}.camera-close .nature-invitation,.camera-first .nature-invitation{top:215rpx}
.nature-exploring::before{height:310rpx;background:linear-gradient(#dce9dfce,#dce9df4a,transparent)}.nature-exploring .home-tabs,.nature-exploring .room-heading{display:none}.nature-heading{position:absolute;top:48rpx;left:36rpx;z-index:2;display:flex;flex-direction:column;gap:8rpx;pointer-events:none}.nature-eyebrow{font:17rpx/1.5 Georgia,serif;letter-spacing:3rpx;color:#6b8371}.nature-title{font-family:"Songti SC","STSong",serif;font-size:52rpx;letter-spacing:5rpx;color:#314f3d}.nature-location{font-size:20rpx;letter-spacing:2rpx;color:#597560}.nature-live-dot{color:#98ad67;font-size:16rpx}.nature-exploring .room-view-tools{top:48rpx;gap:12rpx}.nature-exploring .room-view-mode,.nature-exploring .room-view-pair button{background:#f6f6e5d9;color:#48614d}.nature-guide{position:absolute;left:36rpx;top:210rpx;z-index:2;pointer-events:none;text-shadow:0 1rpx 9rpx #f7f8dc;max-width:55%}.nature-guide text{display:block;font-size:17rpx;color:#66785b;line-height:1.8;letter-spacing:1rpx}.nature-exploring .room-message{background:#f0f4dfd9;color:#496447;max-width:440rpx;font-size:20rpx}.nature-exploring .room-bottom{left:26rpx;right:26rpx}.nature-exploring .room-bag-button>text{color:#526c4b}.nature-exploring .room-help{top:315rpx}
.nature-nearby{position:absolute;right:30rpx;bottom:calc(234rpx + env(safe-area-inset-bottom));z-index:4;display:flex;flex-direction:column;align-items:flex-end;gap:10rpx;max-width:56%}.nature-tool{font-size:18rpx;letter-spacing:2rpx;color:#476448;background:#f4f5decc;padding:7rpx 15rpx;border-radius:8rpx}.home-page .nature-nearby button{background:#405e48e8;color:#faf5d8;padding:18rpx 24rpx;border:1rpx solid #ced5a590;border-radius:14rpx;box-shadow:0 4rpx 12rpx #1735281a;display:flex;flex-direction:column;gap:5rpx;font-size:21rpx;text-align:center}.nature-nearby button>text+text{font:17rpx/1.3 Georgia,serif;opacity:.65}.home-page .nature-nearby button[disabled]{opacity:.7}
.nature-crafting-mask{position:absolute;inset:0;z-index:15;background:#243e3266;display:flex;align-items:center;justify-content:center;padding:24rpx;box-sizing:border-box}.nature-crafting{width:100%;max-width:820rpx;max-height:85vh;display:flex;flex-direction:column;background:#f5f3e5;border:2rpx solid #fff9e7;border-radius:24rpx;box-shadow:0 26rpx 100rpx #18372744;overflow:hidden}.nature-craft-header{display:flex;align-items:center;justify-content:space-between;padding:30rpx 30rpx 20rpx;flex-shrink:0}.nature-craft-header .nature-eyebrow{display:block;font-size:14rpx;letter-spacing:2.5rpx}.nature-craft-title{display:block;font-family:"Songti SC","STSong",serif;font-size:40rpx;color:#3e5d48;letter-spacing:4rpx;margin-top:5rpx}.home-page .nature-craft-header button{font-size:40rpx;color:#80907a;width:52rpx;height:52rpx;border:1rpx solid #d2d6bc;border-radius:50%;line-height:46rpx}.nature-craft-tabs{display:flex;padding:0 30rpx;gap:30rpx;flex-shrink:0;border-bottom:1rpx solid #d4dac8}.home-page .nature-craft-tabs button{font-size:23rpx;color:#919a84;padding:12rpx 0 18rpx;display:flex;gap:10rpx;align-items:center}.home-page .nature-craft-tabs .selected{color:#3b6046;border-bottom:4rpx solid #6a8a59}.nature-craft-tabs button text{font:17rpx Georgia,serif;background:#dce3cc;padding:3rpx 10rpx;border-radius:8rpx}.nature-bench-note{display:block;font-size:18rpx;color:#8d8e73;line-height:1.7;padding:17rpx 30rpx 8rpx;flex-shrink:0}.nature-craft-scroll{display:block;min-height:0;height:48vh;flex-shrink:1;overflow-y:auto}.nature-recipe{display:flex;align-items:center;gap:18rpx;padding:24rpx 28rpx;border-bottom:1rpx solid #dee1d0}.nature-recipe-info{min-width:0;flex:1}.nature-recipe-name{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:#3d5944}.nature-recipe-quantity{font:20rpx Georgia,serif;color:#8b977d}.nature-owned{font-size:15rpx;color:#8a9c76;border:1rpx solid #c9d5b6;padding:2rpx 7rpx;border-radius:5rpx}.nature-material-swatch{width:22rpx;height:22rpx;flex-shrink:0;border-radius:4rpx;transform:rotate(-12deg);box-shadow:inset -4rpx -4rpx 0 #00000015,0 2rpx 4rpx #34442615;border:1rpx solid #ffffff90}.nature-recipe-description{display:block;font-size:18rpx;line-height:1.7;color:#92947e;margin:8rpx 0 11rpx}.nature-ingredients{display:flex;flex-wrap:wrap;gap:7rpx}.nature-ingredients text{font-size:16rpx;line-height:1.5;padding:3rpx 8rpx;background:#e6ead9;border-radius:5rpx;color:#6e8461}.nature-ingredients .missing{color:#a38a6b;background:#eae5d7}.home-page .nature-craft-button{background:#64825b;color:#fff7dc;border-radius:12rpx;padding:14rpx 20rpx;font-size:21rpx;flex-shrink:0}.home-page .nature-craft-button[disabled]{background:#e1e4d4;color:#99a18b;opacity:1}.nature-craft-footer{border-top:1rpx solid #d8ddc9;padding:18rpx 28rpx 22rpx;flex-shrink:0;background:#f5f3e5;position:relative}.nature-craft-footer>text{display:block;font-size:16rpx;color:#929c85;line-height:1.6}.nature-craft-footer>text+text{color:#5b7951;margin-top:7rpx;font-size:19rpx}.nature-craft-footer .nature-storage-error{color:#b47957}.nature-empty{padding:72rpx 20rpx;text-align:center}.nature-empty text{display:block;font-size:24rpx;color:#839570;line-height:1.8}.nature-empty text+text{font-size:18rpx;color:#a0a38b}.nature-material-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:24rpx;gap:14rpx}.nature-material{display:flex;align-items:center;gap:14rpx;padding:22rpx 16rpx;background:#eaecdc;border-radius:12rpx;min-width:0;font-size:21rpx}.nature-material>text+text{margin-left:auto;color:#8b9979;font:20rpx Georgia,serif}
@media(min-width:700px){.nature-crafting{max-width:580px}.nature-heading{left:30px;top:30px}.nature-title{font-size:34px}.nature-eyebrow{font-size:12px}.nature-location{font-size:14px}.nature-guide{left:30px;top:145px}.nature-guide text{font-size:12px}.nature-recipe{padding:16px 20px}.nature-craft-scroll{height:42vh}}@media(max-height:600px){.nature-heading{top:24rpx}.nature-title{font-size:34rpx}.nature-guide{display:none}.nature-exploring .room-view-tools{top:28rpx}.nature-nearby{bottom:205rpx}.nature-crafting{max-height:94vh}.nature-craft-header{padding-top:15rpx;padding-bottom:10rpx}.nature-craft-title{font-size:30rpx}.nature-craft-scroll{height:35vh}.nature-craft-footer{padding:10rpx 24rpx}.nature-bench-note{padding-top:9rpx}}
